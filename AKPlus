    local function stepAuthHijack(dt)
        local ag = findGui("AKAuthGui")
        if not ag then
            return
        end

        local card
        for _, ch in ipairs(ag:GetChildren()) do
            if ch:IsA("Frame") and ch.Size.X.Scale < 0.9 and ch.Size.Y.Scale < 0.9
                and (ch.Size.X.Offset >= 300 or ch.AbsoluteSize.X >= 300) then
                card = ch
                break
            end
        end
        if not card then return end
        card.ClipsDescendants = true

        local cardTop = card.AbsolutePosition.Y
        local cardLeft = card.AbsolutePosition.X
        local cardW = math.max(card.AbsoluteSize.X, card.Size.X.Offset, 340)
        local cardH = math.max(card.AbsoluteSize.Y, card.Size.Y.Offset, 180)
        local hasAbs = (card.AbsoluteSize.X > 10 and card.AbsoluteSize.Y > 10)

        local track
        for _, ch in ipairs(card:GetChildren()) do
            if ch:IsA("Frame") and ch.Visible and ch.Size.Y.Scale == 0
                and ch.Size.Y.Offset >= 2 and ch.Size.Y.Offset <= 8
                and ch.Position.Y.Scale == 0 and ch.Position.Y.Offset >= 75 and ch.Position.Y.Offset <= 130
                and ch:FindFirstChildWhichIsA("Frame") ~= nil then
                track = ch
                break
            end
        end
        if not track then
            for _, d in ipairs(card:GetDescendants()) do
                if d:IsA("Frame") and d.Visible and not hasHiddenAncestor(d, card)
                    and d.Size.Y.Offset >= 2 and d.Size.Y.Offset <= 8
                    and d:FindFirstChildWhichIsA("Frame") ~= nil then
                    local ry = hasAbs and (d.AbsolutePosition.Y - cardTop) or d.Position.Y.Offset
                    if ry >= 75 and ry <= 130 then
                        track = d
                        break
                    end
                end
            end
        end
        local fill = track and track:FindFirstChildWhichIsA("Frame")
        if not track or not fill then return end

        local trackRelY = hasAbs and (track.AbsolutePosition.Y - cardTop) or track.Position.Y.Offset

        local footerFrame, divider
        for _, ch in ipairs(card:GetChildren()) do
            if ch ~= track and ch:IsA("Frame") then
                if ch.Position.Y.Scale >= 0.85 then
                    footerFrame = ch
                elseif ch.Visible and ch.Position.Y.Scale == 0 and ch.Size.Y.Offset >= 1 and ch.Size.Y.Offset <= 2
                    and ch.Position.Y.Offset >= (track.Position.Y.Offset + 8) and ch.Position.Y.Offset <= 175 then
                    divider = ch
                end
            end
        end
        local footerTopRelY
        if footerFrame then
            footerTopRelY = hasAbs and (footerFrame.AbsolutePosition.Y - cardTop) or (cardH - footerFrame.Size.Y.Offset)
        elseif divider then
            footerTopRelY = hasAbs and (divider.AbsolutePosition.Y - cardTop) or divider.Position.Y.Offset
        else
            footerTopRelY = trackRelY + 38
        end

        local lbl = (authStatusLbl and authStatusLbl.Parent and authStatusLbl:IsDescendantOf(card)) and authStatusLbl or nil
        if not lbl then
            local bestScore = 1e9
            for _, d in ipairs(card:GetDescendants()) do
                if d:IsA("TextLabel") and d.Name ~= "_AKPct" and d.Name ~= "_AKDbg" and d.Name ~= "_AKDbg2"
                    and not d:GetAttribute("_AKSuppressed") and not hasHiddenAncestor(d, card)
                    and not (footerFrame and (d == footerFrame or d:IsDescendantOf(footerFrame))) then
                    local ry = hasAbs and (d.AbsolutePosition.Y - cardTop) or d.Position.Y.Offset
                    local rx = hasAbs and (d.AbsolutePosition.X - cardLeft) or (d.Position.X.Scale * cardW + d.Position.X.Offset)
                    local tUp = (d.Text or ""):upper()
                    local isFooter = (ry >= footerTopRelY - 1) or tUp:find("AUTO EXECUTE", 1, true) ~= nil or tUp:find("EVERY TIME", 1, true) ~= nil
                    local isTelem = tUp:find("SLICE ", 1, true) ~= nil or tUp:find(" PAUSES", 1, true) ~= nil or tUp:find("FPS |", 1, true) ~= nil
                    if not isFooter and not isTelem and d.Position.X.Scale < 0.5
                        and d.TextXAlignment ~= Enum.TextXAlignment.Right
                        and ry >= 56 and ry <= (trackRelY + 4) and rx < (cardW * 0.45) then
                        local score = rx - ((tUp:find("LOADING", 1, true) or tUp:find("AK ADMIN", 1, true)) and 500 or 0)
                        if score < bestScore then
                            bestScore = score
                            lbl = d
                        end
                    end
                end
            end
        end
        if not lbl then return end

        -- Suppress duplicate upstream right-side % labels and upstream telemetry labels below the progress bar
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") and d ~= lbl and d.Name ~= "_AKPct" and d.Name ~= "_AKDbg" and d.Name ~= "_AKDbg2"
