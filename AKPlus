                    lastCheckpoint = "S3-ExtractBlob"
                    setStatus("[4/6] Compiling Stage 3...")
                    if canYield then maybeYield(true) end
                else
                    isSubVM = true
                    local slen = #src
                    local q1 = math.floor(slen * 0.25) + 1
                    local q2 = math.floor(slen * 0.50) + 1
                    local q3 = math.floor(slen * 0.75) + 1
                    subSig = tostring(slen)
                        .. "|" .. src:sub(1, 96)
                        .. "|" .. src:sub(q1, q1 + 63)
                        .. "|" .. src:sub(q2, q2 + 63)
                        .. "|" .. src:sub(q3, q3 + 63)
                        .. "|" .. src:sub(math.max(1, slen - 95), slen)
                    local cached = subCache[subSig]
                    if cached and type(cached.fn) == "function" then
                        if cached.bVar then
                            g[cached.bVar] = cached.bVal
                            env[cached.bVar] = cached.bVal
                            pcall(rawset, origEnv, cached.bVar, cached.bVal)
                        end
                        g._AKSubCacheHits = (g._AKSubCacheHits or 0) + 1
                        local proto = cached.fn
                        local wrapper = function(...) return proto(...) end
                        pcall(setfenv, wrapper, env)
                        return wrapper, nil
                    end
                    if canYield then maybeYield(false) end
                end
                local b1, b2, bKey = src:find(",([%w_]+)=%[==%[")
                local e1, e2 = src:find("]==],", b2 or 1, true)
                if b1 and e1 and bKey then
                    bVal = src:sub(b2 + 1, e1 - 1)
                    if isStage3 then
                        bVar = "_AKB"
                    elseif isSubVM then
                        g._AKSubCacheSeq = (g._AKSubCacheSeq or 0) + 1
                        bVar = "_AKBC_" .. tostring(g._AKSubCacheSeq)
                    else
                        subBlobIdx = (subBlobIdx % 4) + 1
                        bVar = "_AKB_" .. tostring(subBlobIdx)
                    end
                    g[bVar] = bVal
                    env[bVar] = bVal
                    pcall(rawset, origEnv, bVar, bVal)
                    src = src:sub(1, b1 - 1) .. "," .. bKey .. "=" .. bVar .. "," .. src:sub(e2 + 1)
                    if canYield then
                        maybeYield(false)
                    end
                end
                if isStage3 then
                    lastCheckpoint = "S3-PatchLoops"
                    src = src
                        :gsub("^return setmetatable", "_AKS();local _AKR=setmetatable", 1)
                        :gsub(":([%w_]+)%(%)%(%.%.%.%)%s*$", ":%1()(...);_AKD();return _AKR", 1)
                end
                src = src
                    :gsub("for (%w+)=1,#(%w+),5 do ", "for %1=1,#%2,5 do if %1%%200==1 then _AKY()end;", 1)
                    :gsub("while (%w+)%+39<=(%w+) do local ", "while %1+39<=%2 do if %1%%4000==1 then _AKY()end;local ", 1)
                    :gsub("while (%w+) do if %1<=([%w_]+)", "while %1 do _AKY();if %1<=%2")
                    :gsub("while true do if (%w+<=%d+) then ", "while true do _AKY();if %1 then ")
                    :gsub("while (%w+)%[(%d+)%]do (%w+)%[(%d+)%]%((%w+),(%w+),%.%.%.%)end;", "while %1[%2]do _AKY();%3[%4](%5,%6,...)end;")
                    :gsub("else U%[90%]=U%[45%]U%[0%]=14386203;end;", "else _AKY();U[90]=U[45]U[0]=14386203;end;", 1)
                    :gsub(
                        "for (%w+)=1,L do local E=U%[209%]%(m,K%)",
                        "for %1=1,L do _AKY();local E=U[209](m,K)"
                    )
                    :gsub(
                        "if (%w+==%d+) then while true do local ",
                        "if %1 then while true do _AKY();local "
                    )
                    :gsub(
                        "while true do F%[7295896%]=W;",
                        "while true do _AKY();F[7295896]=W;"
                    )
                    :gsub(
                        "elseif h==58 then K%[W%[U%]%]=K%[z%[U%]%]%+K%[o%[U%]%]U%+=1;",
                        "elseif h==58 then K[W[U]]=K[z[U]]+(_AKP[K[o[U]]]or K[o[U]])U+=1;",
                        1
                    )
                if canYield then
                    maybeYield(isStage3)
                end
            end
        end

        local fn, err
        if type(src) == "string" and (isStage2 or isStage3 or isSubVM or not s3Done) then
            fn, err = oldLs(selfBindPrefix .. src, name)
            if not fn then
                fn, err = oldLs(src, name)
            end
        else
            fn, err = oldLs(src, name)
        end

        if not fn and (isStage2 or isStage3) then
            setError((isStage3 and "S3 Compile: " or "S2 Compile: ") .. tostring(err))
            return nil, err
        end

        if isStage3 then
            lastCheckpoint = "S3-VMInit"
            setStatus("[5/6] Running VM...")
            if canYield then
                maybeYield(true)
            end
            if task and task.delay then
                task.delay(60, function()
                    if not findGui("AKAuthGui") then _AKD() end
                end)
            end
            strideLeft = 1
            lastY = 0
        end

        if fn and (isStage2 or isStage3 or isSubVM or not s3Done) then
            if not pcall(setfenv, fn, env) then
                local rawFn = fn
                fn = function(...) return rawFn(...) end
                pcall(setfenv, fn, env)
            end
            local okF, fenv = pcall(getfenv, fn)
            if okF and type(fenv) == "table" then
                pcall(rawset, fenv, "debug", targetDbg)
                pcall(rawset, fenv, "loadstring", akLoadstring)
                pcall(rawset, fenv, "load", akLoadstring)
                pcall(rawset, fenv, "getgenv", getgenvFn)
                pcall(rawset, fenv, "ypcall", g.ypcall)
                pcall(rawset, fenv, "_AKP", _AKP)
                pcall(rawset, fenv, "_AKS", _AKS)
                pcall(rawset, fenv, "_AKY", _AKY)
                pcall(rawset, fenv, "_AKD", _AKD)
                pcall(rawset, fenv, "_AKB", g._AKB)
                if bVar then
                    pcall(rawset, fenv, bVar, bVal)
                end
            end
            if isSubVM and subSig and fn then
                if #subCacheOrder >= 32 then
                    local oldest = table.remove(subCacheOrder, 1)
                    local ev = oldest and subCache[oldest]
                    if ev then
                        subCache[oldest] = nil
                        if ev.bVar then
                            g[ev.bVar] = nil
                            env[ev.bVar] = nil
                            pcall(rawset, origEnv, ev.bVar, nil)
                        end
                    end
                end
                subCache[subSig] = { fn = fn, bVar = bVar, bVal = bVal }
                subCacheOrder[#subCacheOrder + 1] = subSig
                local proto = fn
                fn = function(...) return proto(...) end
                pcall(setfenv, fn, env)
            end
            if isSubVM and canYield then
                maybeYield(false)
            end
        end
        return fn, err
    end

    g.loadstring = akLoadstring
    env.loadstring = akLoadstring
    env.load = akLoadstring
    setmetatable(env, {
        __index = function(_, k)
            if k == "game" and isVcScanActive() then
                return scopedGameProxy
            end
            local v = g[k]
            if v ~= nil then return v end
            if callerEnv then
                v = callerEnv[k]
                if v ~= nil then return v end
            end
            return origEnv[k]
        end,
        __newindex = function(t, k, v)
            rawset(t, k, v)
            pcall(function() g[k] = v end)
            pcall(function() origEnv[k] = v end)
            if k == "AKUI" and type(v) == "table" then
                pcall(patchAkTranslator, v)
            end
        end
    })

    g._AKEnv = env
    pcall(function() if _G then _G._AKEnv = env end end)
    pcall(function() if shared then shared._AKEnv = env end end)

    pcall(function()
        if setreadonly then setreadonly(origEnv, false) end
        rawset(origEnv, "debug", targetDbg)
        rawset(origEnv, "iscclosure", g.iscclosure)
        rawset(origEnv, "ypcall", g.ypcall)
        rawset(origEnv, "loadstring", akLoadstring)
        rawset(origEnv, "_AKEnv", env)
        rawset(origEnv, "_AKP", _AKP)
        rawset(origEnv, "_AKS", _AKS)
        rawset(origEnv, "_AKY", _AKY)
        rawset(origEnv, "_AKD", _AKD)
    end)

    local existingGui = findGui("AKAdmin2")
    local alreadyLoaded = (type(g.AKUI) == "table" and existingGui and existingGui:FindFirstChild("!jump", true) ~= nil)
    if alreadyLoaded then
        s3Loaded = true
        pcall(patchAkTranslator, g.AKUI)
        for _, v in pairs(g.AKUI) do
            if type(v) == "function" then
                local okF, fenv = pcall(getfenv, v)
                if okF and type(fenv) == "table" then
                    pcall(rawset, fenv, "loadstring", akLoadstring)
                    pcall(rawset, fenv, "load", akLoadstring)
                    pcall(rawset, fenv, "cloneref", safeCloneref)
                    if wrappedQot then
                        pcall(rawset, fenv, "queue_on_teleport", wrappedQot)
                        pcall(rawset, fenv, "queueonteleport", wrappedQot)
                    end
                    pcall(rawset, fenv, "_AKY", _AKY)
                    pcall(rawset, fenv, "_AKP", _AKP)
                end
            end
        end
        _AKD()
    else
        lastCheckpoint = "HttpGetS1"
        setStatus("[2/6] Fetching AKADMIN.lua...")
        fastWait()
        task.spawn(function()
            if coroutine and coroutine.running then
                local th = coroutine.running()
                if th then
                    local ig = g._OmniIgnoredThreads
                    if type(ig) ~= "table" then
                        ig = setmetatable({}, { __mode = "k" })
                        g._OmniIgnoredThreads = ig
                    end
                    ig[th] = true
                end
            end
            local okRun, runErr = pcall(function()
                local s1Src = game:HttpGet("https://absent.wtf/AKADMIN.lua")
                lastCheckpoint = "CompileS1"
                local s1Fn, s1Err = akLoadstring(s1Src)
                if not s1Fn then
                    error("S1 Compile: " .. tostring(s1Err))
                end
                lastCheckpoint = "RunS1"
                return s1Fn()
            end)
            if not okRun then
                setError(runErr)
            end
        end)
    end
end

