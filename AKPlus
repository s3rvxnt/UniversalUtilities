-- Hook AKUI functions and apply Movement UI + Commands + Persistence patches
local function hookAndApplyAll()
    local ak = genv.AKUI
    if type(ak) == "table" then
        if rawget(ak, "initDone") ~= true and type(genv._RbxUIAttachAkHooks) == "function" then
            pcall(genv._RbxUIAttachAkHooks, ak)
        else
            if type(genv._RbxUIStripInitMt) == "function" then
                pcall(genv._RbxUIStripInitMt, ak)
            end
            if type(genv._RbxUIPatchTranslator) == "function" then
                pcall(genv._RbxUIPatchTranslator, ak)
            end
            local safeSet = genv._RbxUISafeSetAkField
            local kw = genv._RbxUIAkKeyWrappers
            if type(kw) == "table" then
                for _, key in ipairs({ "reanimRun", "vcRun", "vcBuild", "reexecGo" }) do
                    local wFn = kw[key]
                    local cur = rawget(ak, key)
                    if type(wFn) == "function" and type(cur) == "function" then
                        local wrapped = wFn(ak, cur, key)
                        if type(wrapped) == "function" and wrapped ~= cur then
                            if type(safeSet) == "function" then
                                safeSet(ak, ak, key, wrapped, false)
                            else
                                ak[key] = wrapped
                            end
                        end
                    end
                end
            end
        end

        -- Hook any UI Rejoin buttons directly as well
        local gui = findGui("AKAdmin2")
        if gui and not gui:GetAttribute("_RbxUIPlusRejoinBtnsHooked") then
            local hookedAny = false
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextButton") and (d.Text == "Rejoin" or d.Text == "Server Hop") then
                    hookedAny = true
                    trackConn(d.MouseButton1Down:Connect(function()
                        rearmTeleportBeforeHop()
                    end))
                end
            end
            if hookedAny then
                gui:SetAttribute("_RbxUIPlusRejoinBtnsHooked", true)
            end
        end

        if gui and (ak.initDone or (gui:FindFirstChild("!jump", true) and not findGui("AKAuthGui"))) then
            if type(genv._RbxUID) == "function" then
                pcall(genv._RbxUID)
            end
        end
    end
    enforceFpsSettings()
    patchAKReanimSession()
    patchRejoinCommandHooks()
end

