local function runAKPlusReload()
    task.spawn(function()
        if genv._AKReanimBoosterUnload then
            pcall(genv._AKReanimBoosterUnload)
        end
        if type(genv._AKDestroyStatusPill) == "function" then
            pcall(genv._AKDestroyStatusPill)
        end
        local ak = genv.AKUI
        if type(ak) == "table" and type(ak.builtInFns) == "table" and type(ak.builtInFns["!destroy"]) == "function" then
            pcall(ak.builtInFns["!destroy"])
        end
        pcall(function()
            local g1 = findGui("AKAdmin2")
            if g1 then g1:Destroy() end
            local g2 = findGui("AKAuthGui")
            if g2 then g2:Destroy() end
        end)
        for _, k in ipairs({
            "AK_ADMIN_EXECUTED", "AKUI", "AK_SND", "AK_ISLAND",
            "AK_RUN_CMD", "AK_REEXEC_PROMPT", "AK_PRELOAD_HEADSHOT",
            "AK_FPS_BOOST_FN", "AK_POP_DISCORD",
            "AK_TP_ARMED", "AK_TP_Q", "AK_TP_CLR", "AK_LOAD_BEAT",
        }) do
            genv[k] = nil
            if _G then _G[k] = nil end
        end
        genv._AKSubCache = nil
        genv._AKSubCacheOrder = nil
        genv._AKPlusServerBoot = nil
        genv._AKPlusLoadingDM = nil
        genv._AKPlusLoadingStart = nil

        local function parseBuild(s)
            if type(s) ~= "string" then return 0 end
            return tonumber(s:match("AKPlusBuild:(%d+)")) or 1
        end

        local cachedSrc = nil
        local isf = isfile or genv.isfile
        local rdf = readfile or genv.readfile
        local wrf = writefile or genv.writefile
        if type(isf) == "function" and type(rdf) == "function" then
            local okC, cSrc = pcall(function()
                if isf("_akplus_cache.lua") then return rdf("_akplus_cache.lua") end
                return nil
            end)
            if okC and type(cSrc) == "string" and #cSrc > 1000 and cSrc:find("AKPlus", 1, true) then
                cachedSrc = cSrc
            end
        end

        local urls = {
            genv._AKPlusUrl,
            "https://raw.githubusercontent.com/s3rvxnt/UniversalUtilities/main/AKPlus",
            "https://raw.githubusercontent.com/s3rvxnt/UniversalUtilities/main/TempAkAdminFix",
        }
        local chosenSrc = nil
        local cachedBuild = parseBuild(cachedSrc)
        for i = 1, 3 do
            local u = urls[i]
            if type(u) == "string" and #u > 10 then
                local ok, src = pcall(game.HttpGet, game, u)
                if ok and type(src) == "string" and #src > 1000 and src:find("AKPlus", 1, true) then
                    if parseBuild(src) >= cachedBuild then
                        chosenSrc = src
                        if type(wrf) == "function" then
                            pcall(wrf, "_akplus_cache.lua", src)
                        end
                    else
                        chosenSrc = cachedSrc
                    end
                    break
                end
            end
        end
        if not chosenSrc then
            chosenSrc = cachedSrc
        end

        local lastShimLs = genv._AKLastShimLs
        local tp = (type(genv._AKTruePrims) == "table" and genv._AKTruePrims.dm == game) and genv._AKTruePrims or nil
        local dInfo = (type(debug) == "table" and type(debug.info) == "function") and debug.info or nil
        local function pickLs(...)
            local n = select("#", ...)
            local fallback = nil
            for i = 1, n do
                local cand = select(i, ...)
                if type(cand) == "function" then
                    local okL, fnL = pcall(cand, "return 1738")
                    if okL and type(fnL) == "function" then
                        local okR, resR = pcall(fnL)
                        if okR and resR == 1738 then
                            if dInfo then
                                local okS, srcS = pcall(dInfo, cand, "s")
                                if okS and srcS == "[C]" then
                                    return cand
                                end
                            else
                                return cand
                            end
                            if not fallback then
                                fallback = cand
                            end
                        end
                    end
                end
            end
            return fallback
        end
        local ls = pickLs(
            tp and tp.ls or nil,
            genv._AKShimDataModel == game and genv._AKOrigLs or nil,
            loadstring ~= lastShimLs and loadstring or nil,
            genv.loadstring ~= lastShimLs and genv.loadstring or nil,
            loadstring,
            genv.loadstring
        )
        if chosenSrc and ls then
            local okC, fn = pcall(ls, chosenSrc)
            if okC and type(fn) == "function" then
                genv._AKForceReload = true
                pcall(fn)
            end
        end
    end)
end
genv._AKTriggerReload = runAKPlusReload

local function applyWalkSpeedToHums(val)
    if not LocalPlayer then return end
    local chars = {
        LocalPlayer.Character,
        Workspace:FindFirstChild(LocalPlayer.Name .. "Celeste"),
        Workspace:FindFirstChild(LocalPlayer.Name),
    }
    for _, ch in ipairs(chars) do
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.WalkSpeed = val end)
        end
    end
end

local function setWalkSpeed(val, fromSlider)
    local ak = genv.AKUI
    if val == nil then
        applyWalkSpeedToHums(16)
        if ak and type(ak.mvSet) == "function" then
            pcall(ak.mvSet, "ws", nil)
        end
        if not fromSlider and setWalkSpeedSliderUI then
            pcall(setWalkSpeedSliderUI, 16)
        end
    else
        applyWalkSpeedToHums(val)
        if ak and type(ak.mvSet) == "function" then
            pcall(ak.mvSet, "ws", val > 0 and val or nil)
        end
        if not fromSlider and setWalkSpeedSliderUI then
            pcall(setWalkSpeedSliderUI, math.clamp(math.floor(val + 0.5), 16, 300))
        end
    end
end

local function setCfSpeed(val, fromSlider)
    cfSpeedVal = math.max(0, val or 0)
    if not fromSlider and setCfSpeedSliderUI then
        pcall(setCfSpeedSliderUI, math.clamp(math.floor(cfSpeedVal + 0.5), 0, 150))
    end
end

-- Heartbeat CFrame Speed engine (works on both normal characters & <Name>Celeste reanim rigs)
trackConn(RunService.Heartbeat:Connect(function(dt)
    if cfSpeedVal <= 0 or not LocalPlayer then return end
    local char = LocalPlayer.Character
        or Workspace:FindFirstChild(LocalPlayer.Name .. "Celeste")
        or Workspace:FindFirstChild(LocalPlayer.Name)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if hum and hrp and hum.MoveDirection.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (cfSpeedVal * dt))
    end
end))

local function extractSliderParts(card)
    if not card then return nil end
    local titleLbl, valLbl, iconImg, trackFrame
    for _, ch in ipairs(card:GetChildren()) do
        if ch:IsA("ImageLabel") then
            iconImg = ch
        elseif ch:IsA("TextLabel") then
            if ch.Position.X.Scale < 0.5 then
                titleLbl = ch
            else
                valLbl = ch
            end
        elseif ch:IsA("Frame") then
            trackFrame = ch
        end
    end
    if not trackFrame then return nil end
    local fillFrame, knobFrame, hitBtn
    for _, ch in ipairs(trackFrame:GetChildren()) do
        if ch:IsA("TextButton") then
            hitBtn = ch
        elseif ch:IsA("Frame") then
            if ch:FindFirstChildOfClass("UIScale") then
                knobFrame = ch
            else
                fillFrame = ch
            end
        end
    end
    return {
        titleLbl = titleLbl,
        valLbl = valLbl,
        iconImg = iconImg,
        trackFrame = trackFrame,
        fillFrame = fillFrame,
        knobFrame = knobFrame,
        knobScale = knobFrame and knobFrame:FindFirstChildOfClass("UIScale"),
        hitBtn = hitBtn,
    }
end

local function patchMovementUIAndCommands()
    local ak = genv.AKUI
    if type(ak) ~= "table" then return false end

    local speedCmd = function(arg1)
        if type(arg1) == "string" then
            local lw = arg1:lower()
            if lw == "off" or lw == "reset" or lw == "default" then
                setWalkSpeed(nil, false)
                return
            end
        end
        local n = tonumber(arg1)
        if not n then
            ak.lastCmdErr = "Invalid number"
            return
        end
        setWalkSpeed(math.clamp(n, 0, 1000), false)
    end

    local unspeedCmd = function()
        setWalkSpeed(nil, false)
    end

    local cfSpeedCmd = function(arg1)
        if arg1 == nil or arg1 == "" then
            if cfSpeedVal > 0 then
                setCfSpeed(0, false)
            else
                setCfSpeed(35, false)
            end
            return
        end
        if type(arg1) == "string" then
            local lw = arg1:lower()
            if lw == "off" or lw == "reset" or lw == "0" then
                setCfSpeed(0, false)
                return
            end
        end
        local n = tonumber(arg1)
        if not n then
            ak.lastCmdErr = "Invalid number"
            return
        end
        setCfSpeed(math.clamp(n, 0, 500), false)
    end

    local unCfSpeedCmd = function()
        setCfSpeed(0, false)
    end

    local invisCmd = function(arg1)
        if type(arg1) == "string" then
            local lw = arg1:lower()
            if lw == "off" or lw == "0" or lw == "false" then
                disableInvisible(true)
                return
            elseif lw == "on" or lw == "1" or lw == "true" then
                if not invisActive then
                    task.spawn(enableInvisible)
                end
                return
            end
        end
        if invisActive then
            disableInvisible(true)
        else
            task.spawn(enableInvisible)
        end
    end

    local unInvisCmd = function()
        disableInvisible(true)
    end

    local reexecCmd = function()
        runAKPlusReload()
    end

    local function installCmdEntries(cmds, meta)
        if type(cmds) ~= "table" then return end
        cmds["!speed"] = speedCmd
        cmds["!ws"] = speedCmd
        cmds["!walkspeed"] = speedCmd
        cmds["!unspeed"] = unspeedCmd
        cmds["!cfspeed"] = cfSpeedCmd
        cmds["!cframespeed"] = cfSpeedCmd
        cmds["!uncfspeed"] = unCfSpeedCmd
        cmds["!invis"] = invisCmd
        cmds["!invisible"] = invisCmd
        cmds["!uninvis"] = unInvisCmd
        cmds["!uninvisible"] = unInvisCmd
        cmds["!vis"] = unInvisCmd
        cmds["!visible"] = unInvisCmd
        cmds["!reexecute"] = reexecCmd

        for _, rjKey in ipairs({ "!rj", "!rejoin", "!serverhop" }) do
            local curFn = cmds[rjKey]
            if type(curFn) == "function" and curFn ~= genv["_AKWrapped_" .. rjKey] then
                genv["_AKOrigCmd_" .. rjKey] = curFn
                local origRj = curFn
                local wrappedRj = function(...)
                    rearmTeleportBeforeHop()
                    return origRj(...)
                end
                genv["_AKWrapped_" .. rjKey] = wrappedRj
                cmds[rjKey] = wrappedRj
            end
        end

        if type(meta) == "table" then
            meta["!speed"] = "Set character WalkSpeed [number, off]"
            meta["!ws"] = "Set character WalkSpeed [number, off]"
            meta["!walkspeed"] = "Set character WalkSpeed [number, off]"
            meta["!unspeed"] = "Reset WalkSpeed back to normal"
            meta["!cfspeed"] = "Set CFrame movement speed [number, off]"
            meta["!cframespeed"] = "Set CFrame movement speed [number, off]"
            meta["!uncfspeed"] = "Turn off CFrame movement speed"
            meta["!invis"] = "Toggle FE invisibility with 0.5 ghost preview [on, off]"
            meta["!invisible"] = "Toggle FE invisibility with 0.5 ghost preview [on, off]"
            meta["!uninvis"] = "Become visible again at current ghost position"
            meta["!uninvisible"] = "Become visible again at current ghost position"
            meta["!vis"] = "Become visible again at current ghost position"
            meta["!visible"] = "Become visible again at current ghost position"
        end
    end

    -- 3A. Register in both ak.builtInFns (works on every executor) & macRunOne0 upvalues
    if type(ak.builtInFns) == "table" then
        installCmdEntries(ak.builtInFns, nil)
    end

    if type(ak.macRunOne0) == "function" and debug and debug.getupvalues then
        for _, rawUv in pairs(debug.getupvalues(ak.macRunOne0)) do
            local u16 = unwrapTable(rawUv)
            if isPlainEnvTable(u16) then
                local b1 = unwrapTable(rawget(u16, 1))
                local b3 = unwrapTable(rawget(u16, 3))
                local cmds = type(b1) == "table" and unwrapTable(rawget(b1, 239))
                local meta = type(b3) == "table" and unwrapTable(rawget(b3, 239))
                if type(cmds) == "table" and type(meta) == "table" then
                    installCmdEntries(cmds, meta)
                    break
                end
            end
        end
    end

    if type(ak.cmdIcons) == "table" then
        ak.cmdIcons.speed = "gauge"
        ak.cmdIcons.ws = "gauge"
        ak.cmdIcons.walkspeed = "gauge"
        ak.cmdIcons.unspeed = "gauge"
        ak.cmdIcons.cfspeed = "zap"
        ak.cmdIcons.cframespeed = "zap"
        ak.cmdIcons.uncfspeed = "zap"
        ak.cmdIcons.invis = "eye-off"
        ak.cmdIcons.invisible = "eye-off"
        ak.cmdIcons.uninvis = "eye"
        ak.cmdIcons.uninvisible = "eye"
        ak.cmdIcons.vis = "eye"
        ak.cmdIcons.visible = "eye"
    end

    -- 3B. Patch CoreGui.AKAdmin2 Movement Tab (WalkSpeed sync + CFrame Speed Slider Card) & Commands Tab
    local gui = findGui("AKAdmin2")
    if not gui then return true end
    if gui:GetAttribute("_AKPlusCardsInjected") then
        return true
    end

    local wsCard, movSf
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text == "WalkSpeed" and d.Parent and d.Parent:IsA("Frame") then
            wsCard = d.Parent
            movSf = wsCard.Parent
            break
        end
    end

    if wsCard and movSf and movSf:IsA("ScrollingFrame") then
        local wsParts = extractSliderParts(wsCard)
        if wsParts and wsParts.fillFrame and wsParts.knobFrame and wsParts.valLbl then
            -- Find internal curValBox & setSliderUI if accessible via getconnections
            local wsCurValBox, wsOrigSetUI
            if getconnections and wsParts.hitBtn and debug and debug.getupvalues then
                for _, c in ipairs(getconnections(wsParts.hitBtn.InputBegan)) do
                    if c.Function then
                        for _, rawUv in pairs(debug.getupvalues(c.Function)) do
                            local uv = unwrapTable(rawUv)
                            if isPlainEnvTable(uv) and type(rawget(uv, 4)) == "function" then
                                for _, rawUv2 in pairs(debug.getupvalues(rawget(uv, 4))) do
                                    local uv2 = unwrapTable(rawUv2)
                                    if isPlainEnvTable(uv2) and rawget(uv2, 2) == 16 and rawget(uv2, 3) == 300 then
                                        wsCurValBox = unwrapTable(rawget(uv2, 5))
                                        wsOrigSetUI = rawget(uv2, 6)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end

            setWalkSpeedSliderUI = function(val)
                local clamped = math.clamp(math.floor(val + 0.5), 16, 300)
                if type(wsCurValBox) == "table" then
                    wsCurValBox[239] = clamped
                end
                if type(wsOrigSetUI) == "function" then
                    pcall(wsOrigSetUI, clamped)
                else
                    local alpha = math.clamp((clamped - 16) / (300 - 16), 0, 1)
                    wsParts.fillFrame.Size = UDim2.new(alpha, 0, 1, 0)
                    wsParts.knobFrame.Position = UDim2.new(alpha, 0, 0.5, 0)
                    wsParts.valLbl.Text = tostring(clamped)
                end
            end
        end

        -- Inject native "CFrame Speed" Slider Card right below WalkSpeed (LayoutOrder = 3)
        local existingCf = movSf:FindFirstChild("CFSpeedCard")
        if existingCf then
            existingCf:Destroy()
        end

        for _, ch in ipairs(movSf:GetChildren()) do
            if ch:IsA("GuiObject") and ch ~= wsCard and ch.LayoutOrder >= 3 then
                ch.LayoutOrder = ch.LayoutOrder + 1
            end
        end

        local cfCard = trackInst(cloneGuiTree(wsCard))
        if cfCard then
            cfCard.Name = "CFSpeedCard"
            cfCard.LayoutOrder = 3
            cfCard.Parent = movSf

            local cfParts = extractSliderParts(cfCard)
            if cfParts then
                if cfParts.titleLbl then
                    cfParts.titleLbl.Text = "CFrame Speed"
                end
                if cfParts.iconImg and type(ak.setIcon) == "function" then
                    pcall(ak.setIcon, cfParts.iconImg, "zap")
                end

                local minCf, maxCf = 0, 150
                setCfSpeedSliderUI = function(val)
                    local clamped = math.clamp(math.floor(val + 0.5), minCf, maxCf)
                    local alpha = (clamped - minCf) / (maxCf - minCf)
                    if cfParts.fillFrame then
                        cfParts.fillFrame.Size = UDim2.new(alpha, 0, 1, 0)
                    end
                    if cfParts.knobFrame then
                        cfParts.knobFrame.Position = UDim2.new(alpha, 0, 0.5, 0)
                    end
                    if cfParts.valLbl then
                        cfParts.valLbl.Text = tostring(clamped)
                    end
                end

                setCfSpeedSliderUI(cfSpeedVal)

                if cfParts.hitBtn and cfParts.trackFrame then
                    local dragging = false
                    local function updateFromX(x)
                        local absPos = cfParts.trackFrame.AbsolutePosition.X
                        local absSize = math.max(1, cfParts.trackFrame.AbsoluteSize.X)
                        local alpha = math.clamp((x - absPos) / absSize, 0, 1)
                        local newVal = math.floor(minCf + alpha * (maxCf - minCf) + 0.5)
                        setCfSpeedSliderUI(newVal)
                        setCfSpeed(newVal, true)
                    end

                    trackConn(cfParts.hitBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            if cfParts.knobScale then
                                cfParts.knobScale.Scale = 1.2
                            end
                            updateFromX(input.Position.X)
                        end
                    end))

                    trackConn(UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            updateFromX(input.Position.X)
                        end
                    end))

                    trackConn(UserInputService.InputEnded:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                            dragging = false
                            if cfParts.knobScale then
                                cfParts.knobScale.Scale = 1
                            end
                        end
                    end))
                end
            end
        end
