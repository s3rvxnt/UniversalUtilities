local function disableInvisible(snapToCurrent)
    local wasActive = invisActive
    invisActive = false
    if invisGhostConn then
        pcall(function() invisGhostConn:Disconnect() end)
        invisGhostConn = nil
    end
    local char = LocalPlayer and LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local returnCF = hrp and hrp.CFrame
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") or d:IsA("Decal") then
                pcall(function() d.LocalTransparencyModifier = 0 end)
            end
        end
    end
    if invisWeld then
        pcall(function() invisWeld:Destroy() end)
        invisWeld = nil
    end
    if invisSeat then
        pcall(function() invisSeat:Destroy() end)
        invisSeat = nil
    end
    if wasActive and snapToCurrent and hrp and returnCF then
        pcall(function()
            hrp.CFrame = returnCF
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function enableInvisible()
    if invisBusy then return end
    if invisActive then
        disableInvisible(true)
    end
    local char = LocalPlayer and LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hum and hrp and hum.Health > 0) then
        return
    end
    invisBusy = true
    local ok, err = pcall(function()
        local originCF = hrp.CFrame
        local hideY = math.clamp(originCF.Y + 3500, 2500, 9000)
        local hideCF = CFrame.new(originCF.X, hideY, originCF.Z)

        hrp.CFrame = hideCF
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.15)

        if not (char.Parent and hum.Parent and hum.Health > 0 and hrp.Parent) then
            return
        end

        local seat = Instance.new("Seat")
        seat.Name = "_AKInvisSeat"
        seat.Size = Vector3.new(2, 0.2, 2)
        seat.Transparency = 1
        seat.CanCollide = false
        seat.CanTouch = false
        seat.CanQuery = false
        seat.Disabled = true
        seat.Massless = false
        seat.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
        seat.Anchored = false
        seat.RootPriority = 127
        seat.CFrame = hrp.CFrame
        seat.Parent = Workspace

        local targetLimb = char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso") or hrp
        local weld = Instance.new("Weld")
        weld.Name = "_AKInvisWeld"
        weld.Part0 = seat
        weld.Part1 = targetLimb
        weld.C0 = seat.CFrame:ToObjectSpace(targetLimb.CFrame)
        weld.Parent = seat

        invisSeat = seat
        invisWeld = weld
        invisActive = true

        RunService.Heartbeat:Wait()
        if invisActive and seat.Parent and hrp.Parent then
            seat.CFrame = originCF
            hrp.CFrame = originCF
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end

        if invisGhostConn then
            pcall(function() invisGhostConn:Disconnect() end)
        end
        invisGhostConn = RunService.RenderStepped:Connect(function()
            if not invisActive or not char.Parent or not seat.Parent or hum.Health <= 0 then
                disableInvisible(false)
                return
            end
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 1 then
                    if d.LocalTransparencyModifier < 0.5 then
                        d.LocalTransparencyModifier = 0.5
                    end
                elseif d:IsA("Decal") and d.Transparency < 1 then
                    if d.LocalTransparencyModifier < 0.5 then
                        d.LocalTransparencyModifier = 0.5
                    end
                end
            end
        end)
    end)
    invisBusy = false
    if not ok then
        pcall(warn, "[AKPlus !invis Error]", err)
        disableInvisible(true)
    end
end

