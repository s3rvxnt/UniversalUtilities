    local function fastWait()
        if coroutine and coroutine.running then
            local th = coroutine.running()
            if th then
                local ig = g._OmniIgnoredThreads
                if type(ig) ~= "table" then
                    ig = setmetatable({}, { __mode = "k" })
                    g._OmniIgnoredThreads = ig
                end
                if not ig[th] then
                    ig[th] = true
                end
            end
        end
        local w = g._KernelOrigTaskWait or rawTaskWait or (task and task.wait)
        if w then
            return pcall(w)
        end
        return false
    end

    local function updateBudget(sleepGap, totalDt)
        if not isFocused then
            dynBudget = 0.016
            return
        end
        if sleepGap > 0.0002 and sleepGap < 0.200 then
            smoothedEngine = smoothedEngine * 0.78 + sleepGap * 0.22
        end
        if totalDt > 0.085 or sleepGap > 0.065 then
            dynBudget = 0.004
        else
            local headroom = 0.0172 - smoothedEngine
            if headroom >= 0.005 then
                dynBudget = math.clamp(headroom, 0.005, 0.0145)
            else
                dynBudget = math.clamp(smoothedEngine * 0.36, 0.004, 0.0075)
            end
        end
    end

