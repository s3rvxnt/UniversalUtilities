trackConn(Workspace.ChildAdded:Connect(function(child)
    if LocalPlayer and child.Name == LocalPlayer.Name .. "Celeste" then
        task.defer(function()
            patchAKReanimSession()
            optimizeActiveRigs()
        end)
    end
end))

-- Hook AKUI.reanimRun and apply Movement UI + Commands patches (supports 1-script Shim Mode OR post-load Hotfix Mode)
local function hookAndApplyAll()
    local ak = genv.AKUI
    if type(ak) == "table" and type(ak.reanimRun) == "function" then
        if not genv._AKOrigReanimRun then
            genv._AKOrigReanimRun = ak.reanimRun
        end
        local origRun = genv._AKOrigReanimRun
        ak.reanimRun = function(...)
            local r = origRun(...)
            task.defer(patchAKReanimSession)
            return r
        end
    end
    patchAKReanimSession()
    patchMovementUIAndCommands()
end

do
    local gui = findGui("AKAdmin2")
    if type(genv.AKUI) == "table" and gui and gui:FindFirstChild("!jump", true) then
        hookAndApplyAll()
    else
        task.spawn(function()
            local deadline = os.clock() + 60
            while os.clock() < deadline do
                local g2 = findGui("AKAdmin2")
                if type(genv.AKUI) == "table" and g2 and g2:FindFirstChild("!jump", true) then
                    break
                end
                task.wait(0.1)
            end
            hookAndApplyAll()
        end)
    end
end

