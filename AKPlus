local function patchAKReanimSession()
    local cleanupFn = rawget(_G, "_ak_reanim_cleanup") or genv._ak_reanim_cleanup
    if type(cleanupFn) ~= "function" or patchedCleanups[cleanupFn] then
        optimizeActiveRigs()
        return false
    end
    if not debug or not debug.getupvalues then
        optimizeActiveRigs()
        return false
    end

    local setReanimFn, ctx
    for _, rawUv in pairs(debug.getupvalues(cleanupFn)) do
        local uv = unwrapTable(rawUv)
        if isPlainEnvTable(uv) then
            local f2 = rawget(uv, 2)
            local t5 = unwrapTable(rawget(uv, 5))
            if type(f2) == "function" and type(t5) == "table" and rawget(t5, "togglePower") then
                setReanimFn = f2
                ctx = t5
                break
            end
        end
    end
    if not setReanimFn or not ctx then
        optimizeActiveRigs()
        return false
    end

    patchedCleanups[cleanupFn] = true

    -- 1. Patch ctx.tick to native Luau
    local nativeTick = buildNativeTick(ctx)
    if nativeTick then
        ctx.tick = nativeTick
    end

    -- 2. Find setReanim's state table (u16) and patch Heartbeat loop (u16[29])
    for _, rawUv in pairs(debug.getupvalues(setReanimFn)) do
        local uv = unwrapTable(rawUv)
        if isPlainEnvTable(uv) and type(rawget(uv, 29)) == "function" and type(unwrapTable(rawget(uv, 34))) == "table" then
            local u16 = uv
            local nativeHb = buildNativeHeartbeat(rawget(u16, 29))
            if nativeHb then
                rawset(u16, 29, nativeHb)
                local connBox = unwrapTable(rawget(u16, 30))
                if type(connBox) == "table" and typeof(connBox[239]) == "RBXScriptConnection" and connBox[239].Connected then
                    connBox[239]:Disconnect()
                    connBox[239] = RunService.Heartbeat:Connect(nativeHb)
                end
            end

            -- Wrap setReanim so every toggle ON immediately strips TouchTransmitters & constraints
            local origSetReanim = setReanimFn
            local wrappedSetReanim = function(on, ...)
                local res = origSetReanim(on, ...)
                if on then
                    task.defer(optimizeActiveRigs)
                end
                return res
            end
            for _, rawTuv in pairs(debug.getupvalues(ctx.togglePower)) do
                local tuv = unwrapTable(rawTuv)
                if isPlainEnvTable(tuv) and rawget(tuv, 10) == origSetReanim then
                    rawset(tuv, 10, wrappedSetReanim)
                end
            end
            break
        end
    end

    -- 3. Patch playKeyframeAnim's RunService reference to intercept PreSimulation:Connect
    if type(ctx.playName) == "function" then
        for _, rawUv in pairs(debug.getupvalues(ctx.playName)) do
            local uv = unwrapTable(rawUv)
            if isPlainEnvTable(uv) and type(rawget(uv, 9)) == "function" then
                local playKfFn = rawget(uv, 9)
                for _, rawPuv in pairs(debug.getupvalues(playKfFn)) do
                    local puv = unwrapTable(rawPuv)
                    if isPlainEnvTable(puv) and (rawget(puv, 21) == RunService or rawget(puv, 21) == rsPreSimProxy) then
                        rawset(puv, 21, rsPreSimProxy)
                        local animState = unwrapTable(rawget(puv, 7))
                        if type(animState) == "table" and typeof(animState.poseConnection) == "RBXScriptConnection" and animState.poseConnection.Connected then
                            if getconnections then
                                for _, c in ipairs(getconnections(RunService.PreSimulation)) do
                                    if c.Function then
                                        local pt4 = extractLuraphEnvTable(c.Function)
                                        if pt4 and unwrapTable(pt4[0]) == animState then
                                            local nativePre = buildNativePreSim(c.Function)
                                            animState.poseConnection:Disconnect()
                                            animState.poseConnection = RunService.PreSimulation:Connect(nativePre)
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        break
                    end
                end
                break
            end
        end
    end

    optimizeActiveRigs()
    return true
end

-- ============================================================================
-- 3. !speed (!ws, !walkspeed, !unspeed) & !cfspeed (CFrame Speed + UI Slider)
-- ============================================================================
local cfSpeedVal = 0
local setWalkSpeedSliderUI = nil
local setCfSpeedSliderUI = nil

local function applyWalkSpeedToHums(val)
    if not LocalPlayer then return end
    local chars = {
        LocalPlayer.Character,
        Workspace:FindFirstChild(LocalPlayer.Name .. "Celeste"),
        Workspace:FindFirstChild(LocalPlayer.Name),
    }
    for _, ch in ipairs(chars) do
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.WalkSpeed = val end)
        end
    end
end

local function setWalkSpeed(val, fromSlider)
    local ak = genv.AKUI
    if val == nil then
        applyWalkSpeedToHums(16)
        if ak and type(ak.mvSet) == "function" then
            pcall(ak.mvSet, "ws", nil)
        end
        if not fromSlider and setWalkSpeedSliderUI then
            pcall(setWalkSpeedSliderUI, 16)
        end
    else
        applyWalkSpeedToHums(val)
        if ak and type(ak.mvSet) == "function" then
            pcall(ak.mvSet, "ws", val > 0 and val or nil)
        end
        if not fromSlider and setWalkSpeedSliderUI then
            pcall(setWalkSpeedSliderUI, math.clamp(math.floor(val + 0.5), 16, 300))
        end
    end
end

local function setCfSpeed(val, fromSlider)
    cfSpeedVal = math.max(0, val or 0)
    if not fromSlider and setCfSpeedSliderUI then
        pcall(setCfSpeedSliderUI, math.clamp(math.floor(cfSpeedVal + 0.5), 0, 150))
    end
end

-- Heartbeat CFrame Speed engine (works on both normal characters & <Name>Celeste reanim rigs)
trackConn(RunService.Heartbeat:Connect(function(dt)
    if cfSpeedVal <= 0 or not LocalPlayer then return end
    local char = LocalPlayer.Character
        or Workspace:FindFirstChild(LocalPlayer.Name .. "Celeste")
        or Workspace:FindFirstChild(LocalPlayer.Name)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if hum and hrp and hum.MoveDirection.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (cfSpeedVal * dt))
    end
end))

local function extractSliderParts(card)
    if not card then return nil end
    local titleLbl, valLbl, iconImg, trackFrame
    for _, ch in ipairs(card:GetChildren()) do
        if ch:IsA("ImageLabel") then
            iconImg = ch
        elseif ch:IsA("TextLabel") then
            if ch.Position.X.Scale < 0.5 then
                titleLbl = ch
            else
                valLbl = ch
            end
        elseif ch:IsA("Frame") then
            trackFrame = ch
        end
    end
    if not trackFrame then return nil end
    local fillFrame, knobFrame, hitBtn
    for _, ch in ipairs(trackFrame:GetChildren()) do
        if ch:IsA("TextButton") then
            hitBtn = ch
        elseif ch:IsA("Frame") then
            if ch:FindFirstChildOfClass("UIScale") then
                knobFrame = ch
            else
                fillFrame = ch
            end
        end
    end
    return {
        titleLbl = titleLbl,
        valLbl = valLbl,
        iconImg = iconImg,
        trackFrame = trackFrame,
        fillFrame = fillFrame,
        knobFrame = knobFrame,
        knobScale = knobFrame and knobFrame:FindFirstChildOfClass("UIScale"),
        hitBtn = hitBtn,
    }
end

local function patchMovementUIAndCommands()
    local ak = genv.AKUI
    if type(ak) ~= "table" then return false end

    -- 3A. Register !speed, !ws, !walkspeed, !unspeed, !cfspeed, !cframespeed, !uncfspeed
    if type(ak.macRunOne0) == "function" and debug and debug.getupvalues then
        for _, rawUv in pairs(debug.getupvalues(ak.macRunOne0)) do
            local u16 = unwrapTable(rawUv)
            if isPlainEnvTable(u16) then
                local b1 = unwrapTable(rawget(u16, 1))
                local b3 = unwrapTable(rawget(u16, 3))
                local cmds = type(b1) == "table" and unwrapTable(rawget(b1, 239))
                local meta = type(b3) == "table" and unwrapTable(rawget(b3, 239))
                if type(cmds) == "table" and type(meta) == "table" then
                    local speedCmd = function(arg1)
                        if type(arg1) == "string" then
                            local lw = arg1:lower()
                            if lw == "off" or lw == "reset" or lw == "default" then
                                setWalkSpeed(nil, false)
                                return
                            end
                        end
                        local n = tonumber(arg1)
                        if not n then
                            ak.lastCmdErr = "Invalid number"
                            return
                        end
                        setWalkSpeed(math.clamp(n, 0, 1000), false)
                    end

                    local unspeedCmd = function()
                        setWalkSpeed(nil, false)
                    end

                    local cfSpeedCmd = function(arg1)
                        if arg1 == nil or arg1 == "" then
                            if cfSpeedVal > 0 then
                                setCfSpeed(0, false)
                            else
                                setCfSpeed(35, false)
                            end
                            return
                        end
                        if type(arg1) == "string" then
                            local lw = arg1:lower()
                            if lw == "off" or lw == "reset" or lw == "0" then
                                setCfSpeed(0, false)
                                return
                            end
                        end
                        local n = tonumber(arg1)
                        if not n then
                            ak.lastCmdErr = "Invalid number"
                            return
                        end
                        setCfSpeed(math.clamp(n, 0, 500), false)
                    end

                    local unCfSpeedCmd = function()
                        setCfSpeed(0, false)
                    end

                    cmds["!speed"] = speedCmd
                    cmds["!ws"] = speedCmd
                    cmds["!walkspeed"] = speedCmd
                    cmds["!unspeed"] = unspeedCmd
                    cmds["!cfspeed"] = cfSpeedCmd
                    cmds["!cframespeed"] = cfSpeedCmd
                    cmds["!uncfspeed"] = unCfSpeedCmd

                    meta["!speed"] = "Set character WalkSpeed [number, off]"
                    meta["!ws"] = "Set character WalkSpeed [number, off]"
                    meta["!walkspeed"] = "Set character WalkSpeed [number, off]"
                    meta["!unspeed"] = "Reset WalkSpeed back to normal"
                    meta["!cfspeed"] = "Set CFrame movement speed [number, off]"
                    meta["!cframespeed"] = "Set CFrame movement speed [number, off]"
                    meta["!uncfspeed"] = "Turn off CFrame movement speed"
                    break
                end
            end
        end
    end

    if type(ak.cmdIcons) == "table" then
        ak.cmdIcons.speed = "gauge"
        ak.cmdIcons.ws = "gauge"
        ak.cmdIcons.walkspeed = "gauge"
        ak.cmdIcons.unspeed = "gauge"
        ak.cmdIcons.cfspeed = "zap"
        ak.cmdIcons.cframespeed = "zap"
        ak.cmdIcons.uncfspeed = "zap"
    end

    -- 3B. Patch CoreGui.AKAdmin2 Movement Tab (WalkSpeed sync + CFrame Speed Slider Card) & Commands Tab
    local gui = findGui("AKAdmin2")
    if not gui then return true end

    local wsCard, movSf
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text == "WalkSpeed" and d.Parent and d.Parent:IsA("Frame") then
            wsCard = d.Parent
            movSf = wsCard.Parent
            break
        end
    end

    if wsCard and movSf and movSf:IsA("ScrollingFrame") then
        local wsParts = extractSliderParts(wsCard)
        if wsParts and wsParts.fillFrame and wsParts.knobFrame and wsParts.valLbl then
            -- Find internal curValBox & setSliderUI if accessible via getconnections
            local wsCurValBox, wsOrigSetUI
            if getconnections and wsParts.hitBtn and debug and debug.getupvalues then
                for _, c in ipairs(getconnections(wsParts.hitBtn.InputBegan)) do
                    if c.Function then
                        for _, rawUv in pairs(debug.getupvalues(c.Function)) do
                            local uv = unwrapTable(rawUv)
                            if isPlainEnvTable(uv) and type(rawget(uv, 4)) == "function" then
                                for _, rawUv2 in pairs(debug.getupvalues(rawget(uv, 4))) do
                                    local uv2 = unwrapTable(rawUv2)
                                    if isPlainEnvTable(uv2) and rawget(uv2, 2) == 16 and rawget(uv2, 3) == 300 then
                                        wsCurValBox = unwrapTable(rawget(uv2, 5))
                                        wsOrigSetUI = rawget(uv2, 6)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end

            setWalkSpeedSliderUI = function(val)
                local clamped = math.clamp(math.floor(val + 0.5), 16, 300)
                if type(wsCurValBox) == "table" then
                    wsCurValBox[239] = clamped
                end
                if type(wsOrigSetUI) == "function" then
                    pcall(wsOrigSetUI, clamped)
                else
                    local alpha = math.clamp((clamped - 16) / (300 - 16), 0, 1)
                    wsParts.fillFrame.Size = UDim2.new(alpha, 0, 1, 0)
                    wsParts.knobFrame.Position = UDim2.new(alpha, 0, 0.5, 0)
                    wsParts.valLbl.Text = tostring(clamped)
                end
            end
        end

        -- Inject native "CFrame Speed" Slider Card right below WalkSpeed (LayoutOrder = 3)
        local existingCf = movSf:FindFirstChild("CFSpeedCard")
        if existingCf then
            existingCf:Destroy()
        end

        for _, ch in ipairs(movSf:GetChildren()) do
            if ch:IsA("GuiObject") and ch ~= wsCard and ch.LayoutOrder >= 3 then
                ch.LayoutOrder = ch.LayoutOrder + 1
            end
        end

        local cfCard = trackInst(cloneGuiTree(wsCard))
        if cfCard then
            cfCard.Name = "CFSpeedCard"
            cfCard.LayoutOrder = 3
            cfCard.Parent = movSf

            local cfParts = extractSliderParts(cfCard)
            if cfParts then
                if cfParts.titleLbl then
                    cfParts.titleLbl.Text = "CFrame Speed"
                end
                if cfParts.iconImg and type(ak.setIcon) == "function" then
                    pcall(ak.setIcon, cfParts.iconImg, "zap")
                end

                local minCf, maxCf = 0, 150
                setCfSpeedSliderUI = function(val)
                    local clamped = math.clamp(math.floor(val + 0.5), minCf, maxCf)
                    local alpha = (clamped - minCf) / (maxCf - minCf)
                    if cfParts.fillFrame then
                        cfParts.fillFrame.Size = UDim2.new(alpha, 0, 1, 0)
                    end
                    if cfParts.knobFrame then
                        cfParts.knobFrame.Position = UDim2.new(alpha, 0, 0.5, 0)
                    end
                    if cfParts.valLbl then
                        cfParts.valLbl.Text = tostring(clamped)
                    end
                end

                setCfSpeedSliderUI(cfSpeedVal)

                if cfParts.hitBtn and cfParts.trackFrame then
                    local dragging = false
                    local function updateFromX(x)
                        local absPos = cfParts.trackFrame.AbsolutePosition.X
                        local absSize = math.max(1, cfParts.trackFrame.AbsoluteSize.X)
                        local alpha = math.clamp((x - absPos) / absSize, 0, 1)
                        local newVal = math.floor(minCf + alpha * (maxCf - minCf) + 0.5)
                        setCfSpeedSliderUI(newVal)
                        setCfSpeed(newVal, true)
                    end

                    trackConn(cfParts.hitBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            if cfParts.knobScale then
                                cfParts.knobScale.Scale = 1.2
                            end
                            updateFromX(input.Position.X)
                        end
                    end))

                    trackConn(UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            updateFromX(input.Position.X)
                        end
                    end))

                    trackConn(UserInputService.InputEnded:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                            dragging = false
                            if cfParts.knobScale then
                                cfParts.knobScale.Scale = 1
                            end
                        end
                    end))
                end
            end
        end
    end

    -- 3C. Add !speed and !cfspeed cards into the Commands tab ScrollingFrame
    for _, sf in ipairs(gui:GetDescendants()) do
        if sf:IsA("ScrollingFrame") and sf:FindFirstChild("!jump") then
            local jmpCard = sf:FindFirstChild("!jump")
            if jmpCard and jmpCard:FindFirstChild("Ttl") then
                local rowClickFn
                if getconnections and debug and debug.getupvalues then
                    for _, b in ipairs(jmpCard:GetChildren()) do
                        if b:IsA("TextButton") then
                            for _, c in ipairs(getconnections(b.Activated)) do
                                if c.Function then
                                    for _, rawUv in pairs(debug.getupvalues(c.Function)) do
                                        local uv = unwrapTable(rawUv)
                                        if isPlainEnvTable(uv) and rawget(uv, 2) == "!jump" then
                                            local t1 = unwrapTable(rawget(uv, 1))
                                            if type(t1) == "table" and type(rawget(t1, 239)) == "function" then
                                                rowClickFn = rawget(t1, 239)
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                local function addCmdCard(cmdName, descText, iconName, layoutOrder)
                    local existing = sf:FindFirstChild(cmdName)
                    if existing then existing:Destroy() end
                    local card = trackInst(cloneGuiTree(jmpCard))
                    if not card then return nil end
                    card.Name = cmdName
                    card.LayoutOrder = layoutOrder
                    if card:FindFirstChild("Ttl") then
                        card.Ttl.Text = cmdName
                    end
                    if card:FindFirstChild("Desc") then
                        card.Desc.Text = descText
                    end
                    local iconFrame = card:FindFirstChildOfClass("Frame")
                    local iconImg = iconFrame and iconFrame:FindFirstChildOfClass("ImageLabel")
                    if iconImg and type(ak.setIcon) == "function" then
                        pcall(ak.setIcon, iconImg, iconName)
                    end
                    for _, b in ipairs(card:GetChildren()) do
                        if b:IsA("TextButton") then
                            trackConn(b.Activated:Connect(function()
                                if rowClickFn then
                                    pcall(rowClickFn, cmdName)
                                elseif type(ak.runBarCommandAsync) == "function" then
                                    pcall(ak.runBarCommandAsync, cmdName)
                                end
                            end))
                        end
                    end
                    card.Parent = sf
                    return card
                end

                local speedCard = addCmdCard("!speed", "Set character WalkSpeed [number, off]", "gauge", 81)
                local cfSpeedCard = addCmdCard("!cfspeed", "Set CFrame movement speed [number, off]", "zap", 17)

                -- Hook Commands search TextBox so searching filters !speed and !cfspeed too
                for _, tb in ipairs(gui:GetDescendants()) do
                    if tb:IsA("TextBox") and tb.PlaceholderText:find("Search") and tb.PlaceholderText:find("commands") then
                        trackConn(tb:GetPropertyChangedSignal("Text"):Connect(function()
                            local q = tb.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
                            if speedCard and speedCard.Parent then
                                speedCard.Visible = (q == "" or ("!speed walkspeed ws"):find(q, 1, true) ~= nil)
                            end
                            if cfSpeedCard and cfSpeedCard.Parent then
                                cfSpeedCard.Visible = (q == "" or ("!cfspeed cframe speed"):find(q, 1, true) ~= nil)
                            end
                        end))
                        break
                    end
                end
            end
            break
        end
    end

    return true
end

