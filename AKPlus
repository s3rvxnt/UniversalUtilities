local activeConns = {}
local injectedInstances = {}
local patchedCleanups = setmetatable({}, { __mode = "k" })

local function trackConn(c)
    if c then
        activeConns[#activeConns + 1] = c
    end
    return c
end

local function trackInst(inst)
    if inst then
        injectedInstances[#injectedInstances + 1] = inst
    end
    return inst
end

local function unwrapTable(t)
    while type(t) == "table" do
        local mt = (debug and debug.getmetatable and debug.getmetatable(t)) or getmetatable(t)
        if type(mt) == "table" and rawget(mt, "__metatable") == false and type(rawget(mt, "__index")) == "function" and debug and debug.getupvalue then
            local ok, r = pcall(debug.getupvalue, rawget(mt, "__index"), 1)
            if ok and type(r) == "table" and r ~= t then
                t = r
            else
                break
            end
        else
            break
        end
    end
    return t
end

local function isPlainEnvTable(t)
    t = unwrapTable(t)
    return type(t) == "table" and getmetatable(t) == nil and rawget(t, -1) == nil
end

local function cloneGuiTree(inst)
    if not inst then return nil end
    inst.Archivable = true
    for _, d in ipairs(inst:GetDescendants()) do
        d.Archivable = true
    end
    return inst:Clone()
end

-- ============================================================================
-- 1. Narrowphase Physics & Ragdoll Constraint Optimizer
-- Eliminates the 22x22 overlapping MeshPart TouchTransmitter & PGS solver churn
-- between the real character and <Name>Celeste clone (~16-20 ms/frame saved).
-- ============================================================================
local function stripPartLag(inst, isClone, stripWrapTarget)
    if inst:IsA("TouchTransmitter") or inst:IsA("AudioSpeechToText") or inst:IsA("Animator") then
        pcall(inst.Destroy, inst)
    elseif stripWrapTarget and inst:IsA("WrapTarget") then
        pcall(inst.Destroy, inst)
    elseif inst:IsA("BasePart") then
        inst.CanCollide = false
        inst.CanTouch = false
        inst.CanQuery = false
        if isClone then
            inst.Massless = true
        end
    elseif not isClone and (inst:IsA("HingeConstraint") or inst:IsA("BallSocketConstraint")) then
        -- Keep Enabled = true so RequiresNeck / joint connectivity stays valid,
        -- but disable angular limits so PGS solver doesn't fight BulkMoveTo.
        inst.LimitsEnabled = false
    end
end

local function optimizeRig(model, isClone)
    if not model or not model:IsA("Model") then return end
    local stripWrapTarget = (model:FindFirstChildWhichIsA("WrapLayer", true) == nil)
    for _, d in ipairs(model:GetDescendants()) do
        stripPartLag(d, isClone, stripWrapTarget)
    end
    trackConn(model.DescendantAdded:Connect(function(d)
        stripPartLag(d, isClone, stripWrapTarget)
    end))
end

local function optimizeActiveRigs()
    if not LocalPlayer then return end
    local realChar = Workspace:FindFirstChild(LocalPlayer.Name)
    local cloneChar = Workspace:FindFirstChild(LocalPlayer.Name .. "Celeste")
    if realChar and cloneChar then
        optimizeRig(realChar, false)
        optimizeRig(cloneChar, true)
    end
end

-- ============================================================================
-- 2. Luraph VM Hot-Loop De-Virtualizer (Heartbeat + PreSimulation + UI Tick)
-- Replaces the virtualized per-frame VM loops with native Luau closures.
-- ============================================================================
local function extractLuraphEnvTable(fn)
    if type(fn) ~= "function" or not debug or not debug.getupvalue then return nil end
    local ok, u1 = pcall(debug.getupvalue, fn, 1)
    u1 = unwrapTable(u1)
    if ok and isPlainEnvTable(u1) then
        local t4 = unwrapTable(rawget(u1, 4))
        if isPlainEnvTable(t4) then
            return t4
        end
    end
    return nil
end

local function buildNativePreSim(luraphPreSimCb)
    local pt4 = extractLuraphEnvTable(luraphPreSimCb)
    if not pt4 then
        return luraphPreSimCb
    end

    local animState = unwrapTable(pt4[0])
    local cloneCharBox = unwrapTable(pt4[1])
    local blendTimeBox = unwrapTable(pt4[3])
    local ctx = unwrapTable(pt4[4])
    local blendFromMap = unwrapTable(pt4[5])
    local lastTickBox = unwrapTable(pt4[6])
    local motorMap = unwrapTable(pt4[7])

    if type(animState) ~= "table" or type(motorMap) ~= "table" then
        return luraphPreSimCb
    end

    local limbNames = {}
    local motors = {}
    local motorCount = 0
    for limb, motor in pairs(motorMap) do
        motorCount = motorCount + 1
        limbNames[motorCount] = limb
        motors[motorCount] = motor
    end

    return function(dt)
        if not animState.isRunning then return end
        local resolved = animState.resolved
        if not resolved then return end
        local cc = cloneCharBox and cloneCharBox[239]
        if not cc or not cc.Parent then return end

        local ak = genv.AKUI
        local rtk = ak and ak.rtk
        if rtk and rtk.paused then return end

        local dur = animState.totalDuration or 0
        if dur > 0 then
            local spd = animState.speed or 1
            if animState.isReversed then
                animState.elapsedTime = (animState.elapsedTime - dt * spd) % dur
            else
                animState.elapsedTime = (animState.elapsedTime + dt * spd) % dur
            end
        end

        if lastTickBox then
            local lt = (lastTickBox[239] or 0) + dt
            if lt >= 0.066 then
                lastTickBox[239] = 0
                if ctx and ctx.tick then
                    ctx.tick()
                end
            else
                lastTickBox[239] = lt
            end
        end

        local n = #resolved
        if n == 0 then return end
        local et = animState.elapsedTime or 0
        local idx = animState.frameIndex or 1
        if idx < 1 or idx > n then idx = 1 end

        while idx < n and resolved[idx + 1].Time <= et do
            idx = idx + 1
        end
        while idx > 1 and resolved[idx].Time > et do
            idx = idx - 1
        end
        animState.frameIndex = idx

        local kf1 = resolved[idx]
        local kf2 = resolved[idx + 1] or resolved[1]
        local span = kf2.Time - kf1.Time
        local alpha = (span > 0) and math.clamp((et - kf1.Time) / span, 0, 1) or 0

        local bAlpha = nil
        if blendFromMap and next(blendFromMap) ~= nil and blendTimeBox then
            local bt = (blendTimeBox[239] or 0) + dt
            blendTimeBox[239] = bt
            if bt >= 0.32 then
                table.clear(blendFromMap)
            else
                local u = bt / 0.32
                bAlpha = u * u * (3 - 2 * u)
            end
        end

        local d1 = kf1.Data
        local d2 = kf2.Data
        if not bAlpha then
            for i = 1, motorCount do
                local limb = limbNames[i]
                local c1 = d1[limb]
                local c2 = d2[limb]
                local cf = (c1 and c2) and c1:Lerp(c2, alpha) or (c1 or c2)
                if cf then
                    motors[i].Transform = cf
                end
            end
        else
            for i = 1, motorCount do
                local limb = limbNames[i]
                local c1 = d1[limb]
                local c2 = d2[limb]
                local cf = (c1 and c2) and c1:Lerp(c2, alpha) or (c1 or c2)
                if cf then
                    local bf = blendFromMap[limb]
                    if bf then
                        cf = bf:Lerp(cf, bAlpha)
                    end
                    motors[i].Transform = cf
                end
            end
        end
    end
end

local function buildNativeHeartbeat(luraphHbCb)
    local t4 = extractLuraphEnvTable(luraphHbCb)
    if not t4 or type(unwrapTable(t4[14])) ~= "table" or type(unwrapTable(t4[15])) ~= "table" then
        return nil
    end

    local isReanimBox = unwrapTable(t4[0])
    local realCharBox = unwrapTable(t4[1])
    local cloneCharBox = unwrapTable(t4[2])
    local animState = unwrapTable(t4[3])
    local isDeadFn = t4[4]
    local abortFn = t4[5]
    local snakeBox = unwrapTable(t4[6])
    local snakeStepFn = t4[7]
    local coverBox = unwrapTable(t4[8])
    local coverList = unwrapTable(t4[9])
    local zeroVec = t4[10] or Vector3.zero
    local hideBox = unwrapTable(t4[11])
    local hideList = unwrapTable(t4[12])
    local hiddenCfgBox = unwrapTable(t4[13])
    local limbPairs = unwrapTable(t4[14])
    local bulkParts = unwrapTable(t4[15])
    local bulkCFs = unwrapTable(t4[16])
    local ws = t4[17] or Workspace
    local scaleMultBox = unwrapTable(t4[18])
    local scaleInfoBox = unwrapTable(t4[19])
    local cloneHumBox = unwrapTable(t4[20])
    local origHipBox = unwrapTable(t4[21])
    local fireMode = Enum.BulkMoveMode.FireCFrameChanged

    return function(dt)
        if not isReanimBox or not isReanimBox[239] then return end
        local rc = realCharBox and realCharBox[239]
        local cc = cloneCharBox and cloneCharBox[239]
        if not rc or not cc or not rc.Parent or not cc.Parent then
            if abortFn then abortFn() end
            return
        end

        local now = os.clock()
        if animState and now >= (animState.nextCheck or 0) then
            animState.nextCheck = now + 0.2
            if isDeadFn and isDeadFn() then
                if abortFn then abortFn() end
                return
            end
        end

        if snakeBox and snakeBox[239] then
            if snakeStepFn then snakeStepFn(dt) end
            return
        end

        if coverBox and coverBox[239] and coverList then
            for i = 1, #coverList do
                local e = coverList[i]
                local p = e.original
                p.CFrame = e.cframe
                p.AssemblyLinearVelocity = zeroVec
                p.AssemblyAngularVelocity = zeroVec
            end
            return
        end

        if hideBox and hideBox[239] and hideList then
            for i = 1, #hideList do
                local e = hideList[i]
                local p = e.original
                p.CFrame = e.cframe
                p.AssemblyLinearVelocity = zeroVec
                p.AssemblyAngularVelocity = zeroVec
            end
            return
        end

        local hCfg = hiddenCfgBox and hiddenCfgBox[239] and hiddenCfgBox[239]()
        local hParts = type(hCfg) == "table" and hCfg.hiddenBodyParts or nil
        local hPos = type(hCfg) == "table" and hCfg.hiddenBodyPartPositions or nil

        local nLimbs = #limbPairs
        if not hParts then
            for i = 1, nLimbs do
                bulkCFs[i] = limbPairs[i].clone.CFrame
            end
            ws:BulkMoveTo(bulkParts, bulkCFs, fireMode)
            for i = 1, nLimbs do
                local orig = bulkParts[i]
                orig.AssemblyLinearVelocity = zeroVec
                orig.AssemblyAngularVelocity = zeroVec
            end
        else
            for i = 1, nLimbs do
                local lp = limbPairs[i]
                local ccf = lp.clone.CFrame
                local nm = lp.name
                if hParts[nm] and hPos and hPos[nm] then
                    bulkCFs[i] = CFrame.new(hPos[nm]) * (ccf - ccf.Position)
                else
                    bulkCFs[i] = ccf
                end
            end
            ws:BulkMoveTo(bulkParts, bulkCFs, fireMode)
            for i = 1, nLimbs do
                local orig = bulkParts[i]
                orig.AssemblyLinearVelocity = zeroVec
                orig.AssemblyAngularVelocity = zeroVec
            end
        end

        local ak = genv.AKUI
        local rtk = ak and ak.rtk
        if rtk and rtk.live and rtk.step then
            rtk.step()
        end

        local sm = scaleMultBox and scaleMultBox[239] or 1
        if sm ~= 1 then
            local ch = cloneHumBox and cloneHumBox[239]
            local si = scaleInfoBox and scaleInfoBox[239]
            local oh = origHipBox and origHipBox[239] or 2
            if ch and si then
                ch.HipHeight = math.max(0.1, oh * (si.heightScale or 1) * sm)
            end
        end
    end
end

local function buildNativeTick(ctx)
    local ui = ctx and ctx.ui
    if type(ui) ~= "table" or not debug or not debug.getupvalues then return nil end
    for _, rawUv in pairs(debug.getupvalues(ctx.tick)) do
        local uv = unwrapTable(rawUv)
        if isPlainEnvTable(uv) and type(rawget(uv, 3)) == "table" and rawget(uv, 3).totalDuration ~= nil then
            local mainFrame = rawget(uv, 1)
            local uiTbl = rawget(uv, 2)
            local animState = rawget(uv, 3)
            local fmtFn = rawget(uv, 4)
            return function()
                if not mainFrame or not mainFrame.Parent or uiTbl.minimized then return end
                local dur = animState.totalDuration or 0
                local el = animState.elapsedTime or 0
                if not uiTbl.seeking and uiTbl.scrub and uiTbl.scrub.set and dur > 0 then
                    uiTbl.scrub.set(el / dur)
                end
                local sec = math.floor(el)
                if sec ~= uiTbl.lastSec then
                    uiTbl.lastSec = sec
                    if uiTbl.elapsed and fmtFn then
                        uiTbl.elapsed.Text = fmtFn(sec)
                    end
                end
                local tot = math.floor(dur)
                if tot ~= uiTbl.lastTotal then
                    uiTbl.lastTotal = tot
                    if uiTbl.elapsed and uiTbl.total and fmtFn then
                        uiTbl.total.Text = fmtFn(tot)
                    end
                end
            end
        end
    end
    return nil
end

local rsPreSimProxy = setmetatable({
