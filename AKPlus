    local function checkPillWatchdog(now)
        if hasError or s3Done then return end
        if g.AKUI and g.AKUI.initDone then
            if g._RbxUID then g._RbxUID() end
            return
        end
        if (now - lastWatchdogScan) < 0.25 then return end
        lastWatchdogScan = now
        local hasAuth = (findGui("AKAuthGui") ~= nil)
        local ui = findGui("AKAdmin2")
        if ui then
            if uiFirstSeenAt <= 0 then
                uiFirstSeenAt = now
                lastUiDescChangeAt = now
            end
            local okD, desc = pcall(ui.GetDescendants, ui)
            local dCount = (okD and type(desc) == "table") and #desc or 0
            if dCount ~= lastUiDescCount then
                lastUiDescCount = dCount
                lastUiDescChangeAt = now
            end
            local hasJump = (ui:FindFirstChild("!jump", true) ~= nil)
            if not hasAuth then
                if hasJump or dCount >= 1500 then
                    if uiReadySince <= 0 then
                        uiReadySince = now
                    elseif (now - uiReadySince) >= 1.5 and (now - lastUiDescChangeAt) >= 0.8 then
                        if g._RbxUID then g._RbxUID() end
                        return
                    end
                else
                    uiReadySince = 0
                    if dCount > 0 and dCount < 500 and (now - lastUiDescChangeAt) >= 6.0 then
                        if g._RbxUIPhaseARetryDM ~= game and type(g._RbxUITriggerReload) == "function" then
                            g._RbxUIPhaseARetryDM = game
                            g._RbxUIPlusLoadingDM = nil
                            g._RbxUIPlusLoadingStart = nil
                            s3Done = true
                            destroyAllStatusGuis()
                            task.defer(g._RbxUITriggerReload)
                            return
                        elseif g._RbxUID then
                            g._RbxUID()
                            return
                        end
                    elseif dCount >= 500 and (now - lastUiDescChangeAt) >= 3.5 then
                        if g._RbxUID then g._RbxUID() end
                        return
                    elseif (now - uiFirstSeenAt) >= 20.0 then
                        if g._RbxUID then g._RbxUID() end
                        return
                    end
                end
            end
        else
            uiReadySince = 0
        end
        if s3Loaded and (authLatched or ui ~= nil) and not hasAuth and (now - s3Start) >= 28.0 then
            if g._RbxUID then g._RbxUID() end
        end
    end

