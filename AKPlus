local function unwrapTable(t)
    while type(t) == "table" do
        local mt = (debug and debug.getmetatable and debug.getmetatable(t)) or getmetatable(t)
        if type(mt) == "table" and rawget(mt, "__metatable") == false and type(rawget(mt, "__index")) == "function" and debug and debug.getupvalue then
            local ok, a, b = pcall(debug.getupvalue, rawget(mt, "__index"), 1)
            local r = (type(a) == "table" and a) or (type(b) == "table" and b) or nil
            if ok and r and r ~= t then
                t = r
            else
                break
            end
        else
            break
        end
    end
    return t
end

local function isPlainEnvTable(t)
    t = unwrapTable(t)
    return type(t) == "table" and getmetatable(t) == nil and rawget(t, -1) == nil
end

local function cloneGuiTree(inst)
    if not inst then return nil end
    inst.Archivable = true
    for _, d in ipairs(inst:GetDescendants()) do
        d.Archivable = true
