                local minCf, maxCf = 0, 150
                setCfSpeedSliderUI = function(val)
                    local clamped = math.clamp(math.floor(val + 0.5), minCf, maxCf)
                    local alpha = (clamped - minCf) / (maxCf - minCf)
                    if cfParts.fillFrame then
                        cfParts.fillFrame.Size = UDim2.new(alpha, 0, 1, 0)
                    end
                    if cfParts.knobFrame then
                        cfParts.knobFrame.Position = UDim2.new(alpha, 0, 0.5, 0)
                    end
                    if cfParts.valLbl then
                        cfParts.valLbl.Text = tostring(clamped)
                    end
                end

                setCfSpeedSliderUI(cfSpeedVal)

                if cfParts.hitBtn and cfParts.trackFrame then
                    local dragging = false
                    local function updateFromX(x)
                        local absPos = cfParts.trackFrame.AbsolutePosition.X
                        local absSize = math.max(1, cfParts.trackFrame.AbsoluteSize.X)
                        local alpha = math.clamp((x - absPos) / absSize, 0, 1)
                        local newVal = math.floor(minCf + alpha * (maxCf - minCf) + 0.5)
                        setCfSpeedSliderUI(newVal)
                        setCfSpeed(newVal, true)
                    end

                    trackConn(cfParts.hitBtn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            if cfParts.knobScale then
                                cfParts.knobScale.Scale = 1.2
                            end
                            updateFromX(input.Position.X)
                        end
                    end))

                    trackConn(UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            updateFromX(input.Position.X)
                        end
                    end))

                    trackConn(UserInputService.InputEnded:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                            dragging = false
                            if cfParts.knobScale then
                                cfParts.knobScale.Scale = 1
                            end
                        end
                    end))
                end
            end
        end
    end

    -- 3C. Add !speed and !cfspeed cards into the Commands tab ScrollingFrame
    for _, sf in ipairs(gui:GetDescendants()) do
        if sf:IsA("ScrollingFrame") and sf:FindFirstChild("!jump") then
            local jmpCard = sf:FindFirstChild("!jump")
            if jmpCard and jmpCard:FindFirstChild("Ttl") then
                local rowClickFn
                if getconnections and debug and debug.getupvalues then
                    for _, b in ipairs(jmpCard:GetChildren()) do
                        if b:IsA("TextButton") then
                            for _, c in ipairs(getconnections(b.Activated)) do
                                if c.Function then
                                    for _, rawUv in pairs(debug.getupvalues(c.Function)) do
                                        local uv = unwrapTable(rawUv)
                                        if isPlainEnvTable(uv) and rawget(uv, 2) == "!jump" then
                                            local t1 = unwrapTable(rawget(uv, 1))
                                            if type(t1) == "table" and type(rawget(t1, 239)) == "function" then
                                                rowClickFn = rawget(t1, 239)
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                local function addCmdCard(cmdName, descText, iconName, layoutOrder)
                    local existing = sf:FindFirstChild(cmdName)
                    if existing then existing:Destroy() end
                    local card = trackInst(cloneGuiTree(jmpCard))
                    if not card then return nil end
                    card.Name = cmdName
                    card.LayoutOrder = layoutOrder
                    if card:FindFirstChild("Ttl") then
                        card.Ttl.Text = cmdName
                    end
                    if card:FindFirstChild("Desc") then
                        card.Desc.Text = descText
                    end
                    local iconFrame = card:FindFirstChildOfClass("Frame")
                    local iconImg = iconFrame and iconFrame:FindFirstChildOfClass("ImageLabel")
                    if iconImg and type(ak.setIcon) == "function" then
                        pcall(ak.setIcon, iconImg, iconName)
                    end
                    for _, b in ipairs(card:GetChildren()) do
                        if b:IsA("TextButton") then
                            trackConn(b.Activated:Connect(function()
                                if rowClickFn then
                                    pcall(rowClickFn, cmdName)
                                elseif type(ak.runBarCommandAsync) == "function" then
                                    pcall(ak.runBarCommandAsync, cmdName)
                                end
                            end))
                        end
                    end
                    card.Parent = sf
                    return card
                end

                    local speedCard = addCmdCard("!speed", "Set character WalkSpeed [number, off]", "gauge", 81)
                local cfSpeedCard = addCmdCard("!cfspeed", "Set CFrame movement speed [number, off]", "zap", 17)
                local invisCard = addCmdCard("!invis", "Toggle FE invisibility with 0.5 ghost preview [on, off]", "eye-off", 45)
                local unInvisCard = addCmdCard("!uninvis", "Become visible again at current ghost position", "eye", 95)
                gui:SetAttribute("_AKPlusCardsInjected", true)

                -- Hook Commands search TextBox so searching filters custom AKPlus commands too
                for _, tb in ipairs(gui:GetDescendants()) do
                    if tb:IsA("TextBox") and tb.PlaceholderText:find("Search") and tb.PlaceholderText:find("commands") then
                        trackConn(tb:GetPropertyChangedSignal("Text"):Connect(function()
                            local q = tb.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
                            if speedCard and speedCard.Parent then
                                speedCard.Visible = (q == "" or ("!speed walkspeed ws"):find(q, 1, true) ~= nil)
                            end
                            if cfSpeedCard and cfSpeedCard.Parent then
                                cfSpeedCard.Visible = (q == "" or ("!cfspeed cframe speed"):find(q, 1, true) ~= nil)
                            end
                            if invisCard and invisCard.Parent then
                                invisCard.Visible = (q == "" or ("!invis !invisible ghost stealth vanish"):find(q, 1, true) ~= nil)
                            end
                            if unInvisCard and unInvisCard.Parent then
                                unInvisCard.Visible = (q == "" or ("!uninvis !uninvisible !vis !visible invis"):find(q, 1, true) ~= nil)
                            end
                        end))
                        break
                    end
                end
            end
            break
        end
    end

    return true
end

