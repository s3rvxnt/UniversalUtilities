    local s3DoneAt = 0
    local finalPillShown = false
    local uiBuildingNative = false
    local lastWatchdogScan = 0

    local function activeS3Budget()
        if uiBuildingNative and not s3Done then
            return math.max(dynBudget, 0.018)
        end
        return dynBudget
    end

    local function fmtCount(n)
        if n >= 1000000 then
            return string.format("%.2fM", n / 1000000)
        elseif n >= 1000 then
            return string.format("%.1fk", n / 1000)
        end
        return tostring(n)
    end

    -- AKAuthGui hijack state
    local authGui, authCard, authStatusLbl, authPctLbl, authDbgLbl, authDbgLbl2, authFill
    local authLatched = false
    local authBaseText = "Loading AK ADMIN"
    local latchYield = 0
    local maxRawPct = 0
    local visPct = 0
    local lastFillScale = nil

    local function computeRawPct()
        if s3Done or (g.AKUI and g.AKUI.initDone) then
            maxRawPct = 100
            return 100
        end
        local raw = 0
        if uiCount > 0 then
            local pCount = #Players:GetPlayers()
            local expected = 6850 + math.max(0, pCount - 1) * 45
            if uiCount >= expected then
                expected = uiCount + 150
            end
            raw = 14 + math.clamp(uiCount / expected, 0, 0.99) * 84
            if akKeyCount >= 100 then
                local akPct = 14 + math.clamp((akKeyCount - 180) / 860, 0, 0.99) * 84
                if akPct > raw then
                    raw = akPct
                end
            end
        elseif authLatched then
            raw = math.clamp(4 + (yieldTotal - latchYield) * 1.2, 4, 14)
        end
        if raw > maxRawPct then
            maxRawPct = raw
        end
        return maxRawPct
    end

    local function suppressUpstreamAuthLabel(d)
        if not d or not d:IsA("TextLabel") then return end
        d.Visible = false
        d.TextTransparency = 1
        if not d:GetAttribute("_RbxUISuppressed") then
            d:SetAttribute("_RbxUISuppressed", true)
            pcall(function()
                d:GetPropertyChangedSignal("Visible"):Connect(function()
                    if d.Visible then d.Visible = false end
                end)
                d:GetPropertyChangedSignal("TextTransparency"):Connect(function()
                    if d.TextTransparency < 1 then d.TextTransparency = 1 end
                end)
            end)
        end
    end

    local function hasHiddenAncestor(inst, root)
        local p = inst and inst.Parent
        while p and p ~= root do
            if p:IsA("GuiObject") and not p.Visible then
                return true
            end
            p = p.Parent
        end
        return false
    end

    local function stepAuthHijack(dt)
        local ag = findGui("AKAuthGui")
        if not ag then
            return
        end

        local card = (authCard and authCard.Parent == ag) and authCard or nil
        if not card then
            for _, ch in ipairs(ag:GetChildren()) do
                if ch:IsA("Frame") and ch.Size.X.Scale < 0.9 and ch.Size.Y.Scale < 0.9
                    and (ch.Size.X.Offset >= 300 or ch.AbsoluteSize.X >= 300) then
                    card = ch
                    break
                end
            end
        end
        if not card then return end

        local hasAbs = (card.AbsoluteSize.X > 10 and card.AbsoluteSize.Y > 10)
        local isMorphing = false
        for _, ch in ipairs(card:GetChildren()) do
            if ch:IsA("Frame") and (tonumber(ch.ZIndex) or 1) >= 500 and ch.Visible
                and ch.Size.X.Scale >= 0.9 and ch.Size.Y.Scale >= 0.9
                and (tonumber(ch.BackgroundTransparency) or 1) < 0.98 then
                isMorphing = true
                break
            end
        end
        if not isMorphing and authLatched and (s3Done or (g.AKUI and g.AKUI.initDone)) then
            if (card.Size.X.Offset > 0 and card.Size.X.Offset < 350)
                or (card.Size.Y.Offset > 0 and card.Size.Y.Offset < 185)
                or (hasAbs and card.AbsoluteSize.X < 340) then
                isMorphing = true
            end
        end
        if isMorphing then
            if statusFrame and not hasError then
                statusFrame.Visible = false
            end
            for _, nm in ipairs({ "_RbxUIPct", "_RbxUIDbg", "_RbxUIDbg2" }) do
                local ov = card:FindFirstChild(nm)
                if ov and (ov:IsA("TextLabel") or ov:IsA("GuiObject")) then
                    ov.Visible = false
                end
            end
            return
        end

        card.ClipsDescendants = true

        local cardTop = card.AbsolutePosition.Y
        local cardLeft = card.AbsolutePosition.X
        local cardW = math.max(card.AbsoluteSize.X, card.Size.X.Offset, 340)
        local cardH = math.max(card.AbsoluteSize.Y, card.Size.Y.Offset, 180)

        local track
        for _, ch in ipairs(card:GetChildren()) do
            if ch:IsA("Frame") and ch.Visible and ch.Size.Y.Scale == 0
                and ch.Size.Y.Offset >= 2 and ch.Size.Y.Offset <= 8
                and ch.Position.Y.Scale == 0 and ch.Position.Y.Offset >= 75 and ch.Position.Y.Offset <= 130
                and ch:FindFirstChildWhichIsA("Frame") ~= nil then
                track = ch
                break
            end
        end
        if not track then
            for _, d in ipairs(card:GetDescendants()) do
                if d:IsA("Frame") and d.Visible and not hasHiddenAncestor(d, card)
                    and d.Size.Y.Offset >= 2 and d.Size.Y.Offset <= 8
                    and d:FindFirstChildWhichIsA("Frame") ~= nil then
                    local ry = hasAbs and (d.AbsolutePosition.Y - cardTop) or d.Position.Y.Offset
                    if ry >= 75 and ry <= 130 then
                        track = d
                        break
                    end
                end
            end
        end
        local fill = track and track:FindFirstChildWhichIsA("Frame")
        if not track or not fill then return end

        local trackRelY = hasAbs and (track.AbsolutePosition.Y - cardTop) or track.Position.Y.Offset

        local footerFrame, divider
        for _, ch in ipairs(card:GetChildren()) do
            if ch ~= track and ch:IsA("Frame") then
                if ch.Position.Y.Scale >= 0.85 then
                    footerFrame = ch
                elseif ch.Visible and ch.Position.Y.Scale == 0 and ch.Size.Y.Offset >= 1 and ch.Size.Y.Offset <= 2
                    and ch.Position.Y.Offset >= (track.Position.Y.Offset + 8) and ch.Position.Y.Offset <= 175 then
                    divider = ch
                end
            end
        end
        local footerTopRelY
        if footerFrame then
            footerTopRelY = hasAbs and (footerFrame.AbsolutePosition.Y - cardTop) or (cardH - footerFrame.Size.Y.Offset)
        elseif divider then
            footerTopRelY = hasAbs and (divider.AbsolutePosition.Y - cardTop) or divider.Position.Y.Offset
        else
            footerTopRelY = trackRelY + 38
        end

        local lbl = (authStatusLbl and authStatusLbl.Parent and authStatusLbl:IsDescendantOf(card)) and authStatusLbl or nil
        if not lbl then
            local bestScore = 1e9
            for _, d in ipairs(card:GetDescendants()) do
                if d:IsA("TextLabel") and d.Name ~= "_RbxUIPct" and d.Name ~= "_RbxUIDbg" and d.Name ~= "_RbxUIDbg2"
                    and not d:GetAttribute("_RbxUISuppressed") and not hasHiddenAncestor(d, card)
                    and not (footerFrame and (d == footerFrame or d:IsDescendantOf(footerFrame))) then
                    local ry = hasAbs and (d.AbsolutePosition.Y - cardTop) or d.Position.Y.Offset
                    local rx = hasAbs and (d.AbsolutePosition.X - cardLeft) or (d.Position.X.Scale * cardW + d.Position.X.Offset)
                    local tUp = (d.Text or ""):upper()
                    local isFooter = (ry >= footerTopRelY - 1) or tUp:find("AUTO EXECUTE", 1, true) ~= nil or tUp:find("EVERY TIME", 1, true) ~= nil
                    local isTelem = tUp:find("SLICE ", 1, true) ~= nil or tUp:find(" PAUSES", 1, true) ~= nil or tUp:find("FPS |", 1, true) ~= nil
                    if not isFooter and not isTelem and d.Position.X.Scale < 0.5
                        and d.TextXAlignment ~= Enum.TextXAlignment.Right
                        and ry >= 56 and ry <= (trackRelY + 4) and rx < (cardW * 0.45) then
                        local score = rx - ((tUp:find("LOADING", 1, true) or tUp:find("AK ADMIN", 1, true)) and 500 or 0)
                        if score < bestScore then
                            bestScore = score
                            lbl = d
                        end
                    end
                end
            end
        end
        if not lbl then return end

        -- Suppress duplicate upstream right-side % labels and upstream telemetry labels below the progress bar
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") and d ~= lbl and d.Name ~= "_RbxUIPct" and d.Name ~= "_RbxUIDbg" and d.Name ~= "_RbxUIDbg2"
                and not hasHiddenAncestor(d, card)
                and not (footerFrame and (d == footerFrame or d:IsDescendantOf(footerFrame))) then
                local ry = hasAbs and (d.AbsolutePosition.Y - cardTop) or d.Position.Y.Offset
                local tUp = (d.Text or ""):upper()
                local isHeader = (ry < 56) or tUp == "AK ADMIN" or tUp:find("WELCOME BACK", 1, true) ~= nil
                local isFooter = (ry >= footerTopRelY - 1) or tUp:find("AUTO EXECUTE", 1, true) ~= nil or tUp:find("EVERY TIME", 1, true) ~= nil
                local isTelem = tUp:find("SLICE ", 1, true) ~= nil or tUp:find(" PAUSES", 1, true) ~= nil or tUp:find("FPS |", 1, true) ~= nil
                if isTelem or (not isHeader and not isFooter and ry >= 56 and ry < (footerTopRelY - 1)) then
                    suppressUpstreamAuthLabel(d)
                end
            end
        end

        -- Hide top debug pill while AKAuthGui is visible and render debug stats inside AKAuthGui card
        if statusFrame and not hasError then
            statusFrame.Visible = false
        end

        local padX = math.clamp((track.Position.X.Offset > 0 and track.Position.X.Offset) or 22, 16, 28)

        if not card:GetAttribute("_RbxUINudged") then
            card:SetAttribute("_RbxUINudged", true)
            if lbl.Parent == card then
                local origLblY = lbl.Position.Y.Offset
                lbl.Position = UDim2.new(
                    lbl.Position.X.Scale,
                    lbl.Position.X.Offset,
                    lbl.Position.Y.Scale,
                    origLblY - 6
                )
                for _, ch in ipairs(card:GetChildren()) do
                    if ch ~= lbl and ch ~= track and ch ~= footerFrame and ch:IsA("GuiObject") and ch.Visible
                        and ch.Position.Y.Scale == 0 and ch.Size.X.Offset <= 14 and ch.Size.Y.Offset <= 14
                        and math.abs(ch.Position.Y.Offset - origLblY) <= 14 then
                        ch.Position = UDim2.new(
                            ch.Position.X.Scale,
                            ch.Position.X.Offset,
                            ch.Position.Y.Scale,
                            ch.Position.Y.Offset - 6
                        )
                    end
                end
            elseif lbl.Parent and lbl.Parent:IsA("GuiObject") and lbl.Parent.Parent == card then
                local row = lbl.Parent
                row.Position = UDim2.new(
                    row.Position.X.Scale,
                    row.Position.X.Offset,
                    row.Position.Y.Scale,
                    row.Position.Y.Offset - 6
                )
            end

            track.Position = UDim2.new(
                track.Position.X.Scale,
                track.Position.X.Offset,
                track.Position.Y.Scale,
                track.Position.Y.Offset - 6
            )

            local trackBottom = track.Position.Y.Offset + math.max(track.Size.Y.Offset, 4)
            if footerFrame then
                if card.Size.Y.Offset < 220 then
                    local neededH = trackBottom + 38 + footerFrame.Size.Y.Offset
                    local growY = math.max(16, neededH - card.Size.Y.Offset)
                    card.Size = UDim2.new(
                        card.Size.X.Scale,
                        card.Size.X.Offset,
                        card.Size.Y.Scale,
                        card.Size.Y.Offset + growY
                    )
                    if card.AnchorPoint.Y == 0 and card.Position.Y.Scale == 0.5 then
                        card.Position = UDim2.new(
                            card.Position.X.Scale,
                            card.Position.X.Offset,
                            card.Position.Y.Scale,
                            card.Position.Y.Offset - math.floor(growY / 2)
                        )
                    end
                end
            elseif divider then
                local origDivY = divider.Position.Y.Offset
                local shiftDown = math.max(0, (trackBottom + 34) - origDivY)
                if shiftDown > 0 then
                    for _, ch in ipairs(card:GetChildren()) do
                        if ch ~= lbl and ch ~= lbl.Parent and ch ~= track
                            and ch.Name ~= "_RbxUIPct" and ch.Name ~= "_RbxUIDbg" and ch.Name ~= "_RbxUIDbg2"
                            and ch:IsA("GuiObject") and ch.Visible and ch.Position.Y.Scale == 0
                            and ch.Position.Y.Offset >= (origDivY - 2) then
                            ch.Position = UDim2.new(
                                ch.Position.X.Scale,
                                ch.Position.X.Offset,
                                ch.Position.Y.Scale,
                                ch.Position.Y.Offset + shiftDown
                            )
                        end
                    end
                    card.Size = UDim2.new(
                        card.Size.X.Scale,
                        card.Size.X.Offset,
                        card.Size.Y.Scale,
                        card.Size.Y.Offset + shiftDown
                    )
                    if card.AnchorPoint.Y == 0 and card.Position.Y.Scale == 0.5 then
                        card.Position = UDim2.new(
                            card.Position.X.Scale,
                            card.Position.X.Offset,
                            card.Position.Y.Scale,
                            card.Position.Y.Offset - math.floor(shiftDown / 2)
                        )
                    end
                end
            end
        end

        local trackTopOffset = track.Position.Y.Offset - math.floor(track.AnchorPoint.Y * math.max(track.Size.Y.Offset, 4))
        local trackBottomOffset = trackTopOffset + math.max(track.Size.Y.Offset, 4)

        if footerFrame and card.Size.Y.Offset < 230 then
            local neededH = math.max(203, trackBottomOffset + 38 + footerFrame.Size.Y.Offset)
            if card.Size.Y.Offset < neededH then
                local targetCardSize = UDim2.new(
                    card.Size.X.Scale,
                    math.max(card.Size.X.Offset, 380),
                    card.Size.Y.Scale,
                    neededH
                )
                pcall(function()
                    TweenService:Create(
                        card,
                        TweenInfo.new(0.01, Enum.EasingStyle.Linear),
                        { Size = targetCardSize }
                    ):Play()
                end)
                card.Size = targetCardSize
            end
        end

        authDbgLbl = card:FindFirstChild("_RbxUIDbg")
        if not authDbgLbl then
            authDbgLbl = Instance.new("TextLabel")
            authDbgLbl.Name = "_RbxUIDbg"
            authDbgLbl.BackgroundTransparency = 1
            authDbgLbl.Font = Enum.Font.Code
            authDbgLbl.TextSize = 8
            authDbgLbl.TextScaled = false
            authDbgLbl.TextWrapped = false
            authDbgLbl.TextXAlignment = Enum.TextXAlignment.Left
            authDbgLbl.TextYAlignment = Enum.TextYAlignment.Center
            authDbgLbl.Parent = card
        end
        authDbgLbl.ClipsDescendants = true
        authDbgLbl.Visible = true
        authDbgLbl.TextTruncate = Enum.TextTruncate.AtEnd
        authDbgLbl.AnchorPoint = Vector2.new(0, 0)
        authDbgLbl.Position = UDim2.new(0, padX, track.Position.Y.Scale, trackBottomOffset + 4)
        authDbgLbl.Size = UDim2.new(1, -(padX * 2), 0, 11)

        authDbgLbl2 = card:FindFirstChild("_RbxUIDbg2")
        if not authDbgLbl2 then
            authDbgLbl2 = Instance.new("TextLabel")
            authDbgLbl2.Name = "_RbxUIDbg2"
            authDbgLbl2.BackgroundTransparency = 1
            authDbgLbl2.Font = Enum.Font.Code
            authDbgLbl2.TextSize = 8
            authDbgLbl2.TextScaled = false
            authDbgLbl2.TextWrapped = false
            authDbgLbl2.TextXAlignment = Enum.TextXAlignment.Left
            authDbgLbl2.TextYAlignment = Enum.TextYAlignment.Center
            authDbgLbl2.Parent = card
        end
        authDbgLbl2.ClipsDescendants = true
        authDbgLbl2.Visible = true
        authDbgLbl2.TextTruncate = Enum.TextTruncate.AtEnd
        authDbgLbl2.AnchorPoint = Vector2.new(0, 0)
        authDbgLbl2.Position = UDim2.new(0, padX, track.Position.Y.Scale, trackBottomOffset + 16)
        authDbgLbl2.Size = UDim2.new(1, -(padX * 2), 0, 11)

        local now = os.clock()
        local shortExec = (#execName > 10) and execName:sub(1, 10) or execName
        local shortAk = (#lastAkKey > 7) and lastAkKey:sub(1, 7) or lastAkKey
        authDbgLbl.TextTransparency = lbl.TextTransparency
        authDbgLbl.TextColor3 = (maxDt < 0.250) and Color3.fromRGB(130, 235, 170)
            or ((maxDt < 1.0) and Color3.fromRGB(255, 205, 90) or Color3.fromRGB(255, 105, 105))
        authDbgLbl.Text = string.format(
            "AKPlus [%s] %.1fs | %dFPS | Bdg:%.1fms | Lag:%.0fms(x%d)",
            shortExec, now - t0, curFps, activeS3Budget() * 1000, maxDt * 1000, spikeCount
        )

        authDbgLbl2.TextTransparency = lbl.TextTransparency
        authDbgLbl2.TextColor3 = Color3.fromRGB(150, 205, 255)
        local l2Prefix = string.format(
            "Yld:%d | VM:%s | %s | AK:%d(%s) | UI:%d",
            yieldTotal, fmtCount(yCount), lastCheckpoint, akKeyCount, shortAk, uiCount
        )
        local rem = 58 - #l2Prefix - 2
        if rem >= 3 and lastUiNode ~= "-" then
            authDbgLbl2.Text = l2Prefix .. "(" .. lastUiNode:sub(1, rem) .. ")"
        else
            authDbgLbl2.Text = l2Prefix
        end

        if not authLatched then
            local txt = lbl.Text or ""
            local hasBrand = txt:upper():find("AK ADMIN", 1, true) ~= nil or txt:upper():find("LOADING", 1, true) ~= nil
            if hasBrand or (uiCount > 0 and card.Size.Y.Offset < 260) then
                authGui = ag
                authCard = card
                authStatusLbl = lbl
                authFill = fill
                authLatched = true
                latchYield = yieldTotal

                if txt:upper():find("AK ADMIN", 1, true) then
                    local base = txt:gsub("%s*·.*$", ""):gsub("%.%.%.%s*$", "")
                    if base ~= "" then authBaseText = base end
                end

                maxRawPct = 4
                visPct = 4
                lastFillScale = 0.04

                -- Cancel AK Admin's static 0->100% fake tween on the fill bar
                pcall(function()
                    TweenService:Create(
                        authFill,
                        TweenInfo.new(0.01, Enum.EasingStyle.Linear),
                        { Size = UDim2.new(0.04, 0, 1, 0) }
                    ):Play()
                end)
                authFill.Size = UDim2.new(0.04, 0, 1, 0)

                authStatusLbl.TextXAlignment = Enum.TextXAlignment.Left
                authStatusLbl.TextTruncate = Enum.TextTruncate.AtEnd
                authStatusLbl.ClipsDescendants = true
                if authStatusLbl.Parent == card then
                    local lblX = math.clamp(authStatusLbl.Position.X.Offset, padX, 52)
                    authStatusLbl.AnchorPoint = Vector2.new(0, authStatusLbl.AnchorPoint.Y)
                    authStatusLbl.Position = UDim2.new(
                        0,
                        lblX,
                        authStatusLbl.Position.Y.Scale,
                        authStatusLbl.Position.Y.Offset
                    )
                    authStatusLbl.Size = UDim2.new(
                        1,
                        -(lblX + padX + 50),
                        0,
                        math.max(authStatusLbl.Size.Y.Offset, 16)
                    )
                else
                    local lblX = math.clamp(authStatusLbl.Position.X.Offset, 0, 36)
                    authStatusLbl.AnchorPoint = Vector2.new(0, authStatusLbl.AnchorPoint.Y)
                    authStatusLbl.Position = UDim2.new(
                        0,
                        lblX,
                        authStatusLbl.Position.Y.Scale,
                        authStatusLbl.Position.Y.Offset
                    )
                    authStatusLbl.Size = UDim2.new(
                        1,
                        -(lblX + 54),
                        authStatusLbl.Size.Y.Scale,
                        math.max(authStatusLbl.Size.Y.Offset, 16)
                    )
                end

                local pctRef = (authStatusLbl.Parent == card) and authStatusLbl or authStatusLbl.Parent
                authPctLbl = card:FindFirstChild("_RbxUIPct")
                if not authPctLbl then
                    authPctLbl = Instance.new("TextLabel")
                    authPctLbl.Name = "_RbxUIPct"
                    authPctLbl.BackgroundTransparency = 1
                    authPctLbl.Font = authStatusLbl.Font
                    authPctLbl.TextSize = authStatusLbl.TextSize
                    authPctLbl.TextColor3 = authStatusLbl.TextColor3
                    authPctLbl.TextXAlignment = Enum.TextXAlignment.Right
                    authPctLbl.TextYAlignment = authStatusLbl.TextYAlignment
                    authPctLbl.Parent = card
                end
                authPctLbl.ClipsDescendants = true
                authPctLbl.AnchorPoint = Vector2.new(1, pctRef.AnchorPoint.Y)
                authPctLbl.Position = UDim2.new(
                    1, -padX,
                    pctRef.Position.Y.Scale,
                    pctRef.Position.Y.Offset
                )
                authPctLbl.Size = UDim2.new(
                    0, 44,
                    0,
                    math.max(authStatusLbl.Size.Y.Offset, 16)
                )
                authPctLbl.TextTransparency = authStatusLbl.TextTransparency
                authPctLbl.Text = "4%"
            end
        end

        if authLatched then
            if not authGui or not authGui.Parent or not authFill or not authFill.Parent then
                return
            end
            local targetPct = computeRawPct()
            if targetPct >= 100 then
                visPct = 100
            else
                visPct = visPct + (targetPct - visPct) * math.clamp((dt or 0.016) * 24, 0.16, 1)
                if visPct > targetPct then visPct = targetPct end
            end

            local scale = math.clamp(visPct / 100, 0.04, 1)
            -- Re-cancel if AK Admin chains a follow-up tween on authFill.Size
            if lastFillScale and scale < 0.96 and math.abs(authFill.Size.X.Scale - lastFillScale) > 0.025 then
                pcall(function()
                    TweenService:Create(
                        authFill,
