    local function setError(err)
        local clean = tostring(err or "Unknown error")
            :gsub('^%[string ".-"%]:%d+:%s*', "")
            :gsub("^.-:%d+:%s*", "")
            :gsub("%s+", " ")
        setStatus("ERR")
        hasError = true
        s3Done = true
        curStage = "ERR: " .. clean
        pcall(warn, "[AKPlus Error]", err)
        pcall(function()
            if hbConn then hbConn:Disconnect(); hbConn = nil end
            if statusFrame then
                statusFrame.Visible = true
            end
            if pillStroke then
                pillStroke.Color = Color3.fromRGB(255, 90, 90)
