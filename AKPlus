    local function wrapBuiltInFnsExisting(ak, bf)
        if type(ak) ~= "table" or type(bf) ~= "table" then return end
        local rjWrapper = akKeyWrappers["!rj"]
        if type(rjWrapper) == "function" then
            for _, rjKey in ipairs({ "!rj", "!rejoin", "!serverhop" }) do
                local cur = rawget(bf, rjKey)
                if type(cur) == "function" and cur ~= g["_RbxUIWrapped_" .. rjKey] then
                    local wrapped = rjWrapper(ak, cur, rjKey)
                    if type(wrapped) == "function" then
                        safeSetAkField(ak, bf, rjKey, wrapped, true)
                    end
                end
            end
        end
    end

    local function attachBuiltInFnsProxy(ak, bf)
        if type(ak) ~= "table" or type(bf) ~= "table" then return end
        wrapBuiltInFnsExisting(ak, bf)
        if rawget(ak, "initDone") == true then return end
        if getmetatable(bf) == nil then
            local bfMt = g._RbxUIBfInitMt
            if type(bfMt) ~= "table" then
                bfMt = {
                    __newindex = function(t, k, v)
                        local curAk = g.AKUI
                        local rjW = akKeyWrappers["!rj"]
                        if type(curAk) == "table"
                            and (k == "!rj" or k == "!rejoin" or k == "!serverhop")
                            and type(v) == "function"
                            and type(rjW) == "function"
                            and v ~= g["_RbxUIWrapped_" .. k]
                        then
                            local w = rjW(curAk, v, k)
                            if type(w) == "function" then
                                v = w
                            end
                        end
                        rawset(t, k, v)
                    end
                }
                g._RbxUIBfInitMt = bfMt
            end
            pcall(setmetatable, bf, bfMt)
        end
    end

    local function wrapAkExistingTargets(ak)
        if type(ak) ~= "table" then return end
        for _, key in ipairs({ "trHook", "trLiveCand", "reanimRun", "vcRun", "vcBuild", "reexecGo" }) do
            local wFn = akKeyWrappers[key]
            local cur = rawget(ak, key)
            if type(wFn) == "function" and type(cur) == "function" then
                local wrapped = wFn(ak, cur, key)
                if type(wrapped) == "function" and wrapped ~= cur then
                    safeSetAkField(ak, ak, key, wrapped, false)
                end
            end
        end
        local bf = rawget(ak, "builtInFns")
        if type(bf) == "table" then
            attachBuiltInFnsProxy(ak, bf)
        end
        local lang = (type(ak.prefs) == "table" and ak.prefs.lang) or "en"
        if lang == "en" and ak.trLibOn == true then
            ak.trLibOn = false
        end
    end

    local function attachAkPreSnapshotHooks(ak)
        if type(ak) ~= "table" then return end
        g._RbxUIAttachedAKUI = ak
        wrapAkExistingTargets(ak)
        if rawget(ak, "initDone") == true then
            stripAkInitMetatables(ak)
            return
        end
        if getmetatable(ak) == nil then
            local akMt = g._RbxUIAkInitMt
            if type(akMt) ~= "table" then
                akMt = {
                    __newindex = function(t, k, v)
                        if k == "initDone" and v == true then
                            wrapAkExistingTargets(t)
                            stripAkInitMetatables(t)
                            rawset(t, k, v)
                            return
                        end
                        if k == "builtInFns" and type(v) == "table" then
                            attachBuiltInFnsProxy(t, v)
                            rawset(t, k, v)
                            return
                        end
                        local wFn = akKeyWrappers[k]
                        if type(wFn) == "function" and type(v) == "function" then
                            local w = wFn(t, v, k)
                            if type(w) == "function" then
                                v = w
                            end
                        end
                        rawset(t, k, v)
                    end
                }
                g._RbxUIAkInitMt = akMt
            end
            pcall(setmetatable, ak, akMt)
        end
    end
    g._RbxUIAttachAkHooks = attachAkPreSnapshotHooks

    local function patchAkTranslator(ak)
        if type(ak) ~= "table" then return end
        if rawget(ak, "initDone") ~= true then
            attachAkPreSnapshotHooks(ak)
            return
        end
        stripAkInitMetatables(ak)
        for _, key in ipairs({ "trHook", "trLiveCand" }) do
            local wFn = akKeyWrappers[key]
            local cur = rawget(ak, key)
            if type(wFn) == "function" and type(cur) == "function" then
                local wrapped = wFn(ak, cur, key)
                if type(wrapped) == "function" and wrapped ~= cur then
                    safeSetAkField(ak, ak, key, wrapped, false)
                end
            end
        end
        local lang = (type(ak.prefs) == "table" and ak.prefs.lang) or "en"
        if lang == "en" and ak.trLibOn == true then
            ak.trLibOn = false
        end
    end
    g._RbxUIPatchTranslator = patchAkTranslator

    local function updatePill(dt)
        local now = os.clock()
        local akCur = g.AKUI
        if not hasError and type(akCur) == "table" then
            if rawget(akCur, "initDone") ~= true then
                if g._RbxUIAttachedAKUI ~= akCur
                    or getmetatable(akCur) ~= g._RbxUIAkInitMt
                    or akCur.trHook ~= g._RbxUIWrappedTrHook
                    or akCur.trLiveCand ~= g._RbxUIWrappedTrLive
                then
                    pcall(attachAkPreSnapshotHooks, akCur)
                end
            else
                stripAkInitMetatables(akCur)
                if (akCur.trHook ~= g._RbxUIWrappedTrHook or akCur.trLiveCand ~= g._RbxUIWrappedTrLive)
                    and g._RbxUISkipTranslatorRetry ~= akCur
                then
                    pcall(patchAkTranslator, akCur)
                    if akCur.trHook ~= g._RbxUIWrappedTrHook and type(rawget(akCur, "tamper")) == "function" then
                        g._RbxUISkipTranslatorRetry = akCur
                    end
                end
            end
        end
        if not hasError and (now - lastUiCheck > 0.035) then
            lastUiCheck = now
            pcall(function()
                if type(g.AKUI) == "table" then
                    local lang = (type(g.AKUI.prefs) == "table" and g.AKUI.prefs.lang) or "en"
                    if lang == "en" and g.AKUI.trLibOn == true then
                        g.AKUI.trLibOn = false
                    end
                    local kc = 0
                    for k, _ in pairs(g.AKUI) do
                        kc = kc + 1
                        if not seenAkKeys[k] and type(k) == "string" then
                            seenAkKeys[k] = true
                            lastAkKey = k
                        end
                    end
                    akKeyCount = kc
                    if type(g.AKUI.conns) == "table" then
                        akConnCount = #g.AKUI.conns
                    end
                end
                local ui = findGui("AKAdmin2")
                local hasAuthNow = (findGui("AKAuthGui") ~= nil)
                uiBuildingNative = (not s3Done and ui ~= nil and hasAuthNow)
                if ui then
                    lastCheckpoint = "S3-UI"
                    local desc = ui:GetDescendants()
                    uiCount = #desc
                    local kids = ui:GetChildren()
                    local lastKid = kids[#kids]
                    local leaf = desc[#desc]
                    if lastKid then
                        local kn = lastKid.Name
                        local shortKn = kn
                            :gsub("PanelHolder", "Pnl")
                            :gsub("CmdBarHolder", "CmdBar")
                            :gsub("CmdListHolder", "CmdLst")
                            :gsub("DynamicIsland", "Island")
                            :gsub("InfoHolder", "Info")
                        local ln = (leaf and leaf ~= lastKid and leaf.Name or "")
                        local nodeStr = (ln ~= "" and (shortKn .. ">" .. ln) or shortKn)
                        if #nodeStr > 20 then
                            nodeStr = nodeStr:sub(1, 20)
                        end
                        lastUiNode = nodeStr
                        if kn:find("^Rail") or kn == "InfoHolder" then
                            uiPhase = "Navigation"
                        elseif kn == "DynamicIsland" or kn == "IslandStats" then
                            uiPhase = "Dynamic Island"
                        elseif kn == "CmdBarHolder" or kn == "CmdListHolder" then
                            uiPhase = "Command Bar"
                        elseif kn == "PanelHolder" then
                            local tl = lastKid:FindFirstChildWhichIsA("TextLabel", true)
                            local raw = tl and tl.Text or ""
                            if raw ~= "" and #raw <= 28 then
                                if raw:match("^[%u%s]+$") then
                                    raw = raw:lower()
                                        :gsub("(%a)([%w']*)", function(a, b) return a:upper() .. b end)
                                        :gsub("%f[%a]Ak%f[%A]", "AK")
                                end
                                uiPhase = raw
                            end
                        end
                    end
                elseif findGui("AKAuthGui") then
                    lastCheckpoint = authLatched and "S3-PostAuth" or "S3-Auth"
                end
            end)
        end
        if not hasError then
            pcall(stepAuthHijack, dt)
        end
        if not statusLbl or not subLbl then return end
        local pctStr = (not hasError and (uiCount > 0 or authLatched))
            and string.format(" (%d%% | UI:%d | AKUI:%d)", math.floor(math.max(visPct, computeRawPct()) + 0.5), uiCount, akKeyCount)
            or string.format(" (Chk:%s)", lastCheckpoint)
        statusLbl.Text = string.format("AKPlus [%s] | %s%s", execName, curStage, pctStr)
        subLbl.Text = string.format(
            "%.1fs | %dFPS | Bdg:%.1fms | Lag:%.0fms(x%d) | Yld:%d | VM:%s",
            now - t0, curFps, activeS3Budget() * 1000, maxDt * 1000, spikeCount, yieldTotal, fmtCount(yCount)
        )
        if not hasError then
            subLbl.TextColor3 = (maxDt < 0.250) and Color3.fromRGB(130, 235, 170)
                or ((maxDt < 1.0) and Color3.fromRGB(255, 205, 90) or Color3.fromRGB(255, 105, 105))
        end
    end

