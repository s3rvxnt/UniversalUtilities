    local function peelUpvalueCFn(roots, acceptFn, preferNameFn)
        local visited = {}
        local queue = {}
        for i = 1, #roots do
            local r = roots[i]
            if type(r) == "function" then
                queue[#queue + 1] = r
            end
        end
        for _ = 1, 3 do
            local nextQueue = {}
            local fallbackMatch = nil
            for i = 1, #queue do
                local fn = queue[i]
                if not visited[fn] then
                    visited[fn] = true
                    local uvs = collectUpvalues(fn)
                    for j = 1, #uvs do
                        local u = uvs[j]
                        local v = u.val
                        if type(v) == "function" then
                            if isNativeCFn(v) and (not acceptFn or acceptFn(v, u.name)) then
                                if preferNameFn and u.name ~= "" and preferNameFn(u.name) then
                                    return v
                                elseif not fallbackMatch then
                                    fallbackMatch = v
                                end
                            elseif not isNativeCFn(v) and not visited[v] then
                                nextQueue[#nextQueue + 1] = v
                            end
                        end
                    end
                end
            end
            if fallbackMatch then
                return fallbackMatch
            end
            queue = nextQueue
            if #queue == 0 then
                break
            end
        end
        return nil
    end

