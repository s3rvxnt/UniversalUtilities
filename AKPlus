    local rawTaskWait = g._KernelOrigTaskWait or (task and task.wait)
    local t0 = os.clock()
    local smoothedEngine = 0.0035
    local dynBudget = 0.012
    local dynStride = 128
    local strideLeft = 128
    local lastStrideClock = t0

    pcall(function()
        if type(g._RbxUIFocusConns) == "table" then
            for _, cn in ipairs(g._RbxUIFocusConns) do
                pcall(function() cn:Disconnect() end)
            end
        end
        local c1 = UserInputService.WindowFocused:Connect(function()
            isFocused = true
            if dynBudget > 0.0115 then
                dynBudget = 0.008
            end
        end)
        local c2 = UserInputService.WindowFocusReleased:Connect(function()
            isFocused = false
        end)
        local c3 = RunService.Heartbeat:Connect(function()
            curFrameId = curFrameId + 1
        end)
        g._RbxUIFocusConns = { c1, c2, c3 }
    end)

    local function fastWait()
        if coroutine and coroutine.running then
            local th = coroutine.running()
            if th then
                local ig = g._OmniIgnoredThreads
                if type(ig) ~= "table" then
                    ig = setmetatable({}, { __mode = "k" })
                    g._OmniIgnoredThreads = ig
                end
                if not ig[th] then
                    ig[th] = true
                end
            end
        end
        local w = g._KernelOrigTaskWait or rawTaskWait or (task and task.wait)
        if w then
            return pcall(w)
        end
        return false
    end

    local function updateBudget(sleepGap, totalDt)
        if not isFocused then
            dynBudget = 0.018
            return
        end
        if sleepGap > 0.0002 and sleepGap < 0.200 then
            smoothedEngine = smoothedEngine * 0.78 + sleepGap * 0.22
        end
        if totalDt > 0.095 then
            dynBudget = math.max(dynBudget * 0.65, 0.006)
        elseif totalDt <= 0.0165 then
            dynBudget = math.min(dynBudget + 0.0012, 0.0115)
        elseif totalDt <= 0.022 then
            dynBudget = math.clamp(dynBudget + (0.0195 - totalDt) * 0.25, 0.0075, 0.0110)
        else
            dynBudget = math.clamp(dynBudget * 0.85, 0.006, 0.0105)
        end
    end

    -- Built-in live diagnostic pill + AKAuthGui live progress hijacker
    local statusGui, statusFrame, pillStroke, statusLbl, subLbl, hbConn
    local lastY = t0
    local maxDt = 0
    local curFps = 60
    local spikeCount = 0
    local yieldTotal = 0
    local yCount = 0
    local uiCount = 0
    local uiPhase = ""
    local lastUiNode = "-"
    local akKeyCount = 0
    local lastAkKey = "-"
    local seenAkKeys = {}
    local akConnCount = 0
    local lastCheckpoint = "InitShim"
    local lastUiCheck = 0
    local curStage = "[1/6] Init"
