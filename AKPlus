local function enforceFpsSettings()
    local ak = genv.AKUI
    if type(ak) == "table" and type(ak.fpsApply) == "function" then
        pcall(ak.fpsApply)
    end
    local sfc = genv._AKLastShimSetFpsCap or genv.setfpscap or genv._AKOrigSetFpsCap or setfpscap or set_fps_cap or genv.set_fps_cap
    if type(sfc) == "function" then
        local prefs = (type(ak) == "table" and type(ak.prefs) == "table") and ak.prefs or nil
        local explicitCap = tonumber(prefs and (prefs.fpsCap or prefs.fps or prefs.maxFps)) or tonumber(genv.AK_FPS_VALUE)
        if prefs and prefs.fpsUnlimited == false and explicitCap and explicitCap > 0 and explicitCap <= 9999 then
            pcall(sfc, explicitCap)
        elseif explicitCap and explicitCap > 60 and explicitCap <= 9999 and (not prefs or prefs.fpsUnlimited == false) then
            pcall(sfc, explicitCap)
        else
            pcall(sfc, 9999)
        end
    end
end

-- Hook AKUI functions and apply Movement UI + Commands + Persistence patches
local function hookAndApplyAll()
    local ak = genv.AKUI
    if type(ak) == "table" then
        if type(genv._AKPatchTranslator) == "function" then
            pcall(genv._AKPatchTranslator, ak)
        end

        if type(ak.reanimRun) == "function" and ak.reanimRun ~= genv._AKWrappedReanimRun then
            genv._AKOrigReanimRun = ak.reanimRun
            local origRun = ak.reanimRun
            local wrappedRun = function(...)
                local r = origRun(...)
                task.defer(patchAKReanimSession)
                return r
            end
            genv._AKWrappedReanimRun = wrappedRun
            ak.reanimRun = wrappedRun
        end

        -- Scoped CoreGui scan accelerator for !antivcban (vcRun / vcBuild)
        for _, vcKey in ipairs({ "vcRun", "vcBuild" }) do
            if type(ak[vcKey]) == "function" and ak[vcKey] ~= genv["_AKWrapped_" .. vcKey] then
                genv["_AKOrig_" .. vcKey] = ak[vcKey]
                local origVcFn = ak[vcKey]
                local wrappedVcFn = function(...)
                    local th = coroutine and coroutine.running and coroutine.running() or nil
                    local vct = genv._AKVcThreads
                    if th and type(vct) == "table" then
                        vct[th] = true
                    end
                    local okCall, r1, r2, r3 = pcall(origVcFn, ...)
                    if th and type(vct) == "table" then
                        vct[th] = nil
                    end
                    if not okCall then
                        error(r1, 2)
                    end
                    return r1, r2, r3
                end
                genv["_AKWrapped_" .. vcKey] = wrappedVcFn
                ak[vcKey] = wrappedVcFn
            end
        end

        -- Hook AKUI.reexecGo so clicking Re-execute reloads AKPlus instead of vanilla AK Admin
        if type(ak.reexecGo) == "function" and ak.reexecGo ~= genv._AKWrappedReexecGo then
            genv._AKOrigReexecGo = ak.reexecGo
            local wrappedReexec = function()
                runAKPlusReload()
            end
            genv._AKWrappedReexecGo = wrappedReexec
            ak.reexecGo = wrappedReexec
        end

        -- Hook any UI Rejoin buttons directly as well
        local gui = findGui("AKAdmin2")
        if gui and not gui:GetAttribute("_AKPlusRejoinBtnsHooked") then
            local hookedAny = false
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextButton") and (d.Text == "Rejoin" or d.Text == "Server Hop") then
                    hookedAny = true
                    trackConn(d.MouseButton1Down:Connect(function()
                        rearmTeleportBeforeHop()
                    end))
                end
            end
            if hookedAny then
                gui:SetAttribute("_AKPlusRejoinBtnsHooked", true)
            end
        end

        if gui and (gui:FindFirstChild("!jump", true) or ak.initDone) then
            if type(genv._AKD) == "function" then
                pcall(genv._AKD)
            end
            if task and task.delay and type(genv._AKDestroyStatusPill) == "function" then
                task.delay(1.8, function()
                    pcall(genv._AKDestroyStatusPill)
                end)
            end
        end
    end
    enforceFpsSettings()
    patchAKReanimSession()
    patchMovementUIAndCommands()
end

genv._AKOnStage3Done = function()
    hookAndApplyAll()
    if task and task.delay then
        task.delay(0.5, hookAndApplyAll)
        task.delay(1.5, enforceFpsSettings)
    end
end

do
    local gui = findGui("AKAdmin2")
    if type(genv.AKUI) == "table" and gui and gui:FindFirstChild("!jump", true) then
        hookAndApplyAll()
        if task and task.delay then
            task.delay(0.8, enforceFpsSettings)
            task.delay(2.0, enforceFpsSettings)
        end
    else
        task.spawn(function()
            if coroutine and coroutine.running then
                local th = coroutine.running()
                if th then
                    local ig = genv._OmniIgnoredThreads
                    if type(ig) ~= "table" then
                        ig = setmetatable({}, { __mode = "k" })
                        genv._OmniIgnoredThreads = ig
                    end
                    ig[th] = true
                end
            end
            local rawW = genv._KernelOrigTaskWait or task.wait
            local deadline = os.clock() + 60
            while os.clock() < deadline do
                local g2 = findGui("AKAdmin2")
                if type(genv.AKUI) == "table" and g2 and g2:FindFirstChild("!jump", true) then
                    break
                end
                rawW(0.05)
            end
            hookAndApplyAll()
            rawW(0.6)
            hookAndApplyAll()
            rawW(1.4)
            enforceFpsSettings()
        end)
    end
end

