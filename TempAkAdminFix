local function unwrapTable(t)
    while type(t) == "table" do
        local mt = (debug and debug.getmetatable and debug.getmetatable(t)) or getmetatable(t)
        if type(mt) == "table" and rawget(mt, "__metatable") == false and type(rawget(mt, "__index")) == "function" and debug and debug.getupvalue then
            local ok, a, b = pcall(debug.getupvalue, rawget(mt, "__index"), 1)
            local r = (type(a) == "table" and a) or (type(b) == "table" and b) or nil
            if ok and r and r ~= t then
                t = r
            else
                break
            end
        else
            break
        end
    end
    return t
end

local function isPlainEnvTable(t)
    t = unwrapTable(t)
    return type(t) == "table" and getmetatable(t) == nil and rawget(t, -1) == nil
end

-- ============================================================================
-- 1. Narrowphase Physics & Ragdoll Constraint Optimizer
-- Eliminates the 22x22 overlapping MeshPart TouchTransmitter & PGS solver churn
-- between the real character and <Name>Celeste clone (~16-20 ms/frame saved).
-- ============================================================================
local function stripPartLag(inst, isClone, stripWrapTarget)
    if inst:IsA("TouchTransmitter") or inst:IsA("AudioSpeechToText") or inst:IsA("Animator") then
        pcall(inst.Destroy, inst)
    elseif stripWrapTarget and inst:IsA("WrapTarget") then
        pcall(inst.Destroy, inst)
    elseif inst:IsA("BasePart") then
        inst.CanCollide = false
        inst.CanTouch = false
        inst.CanQuery = false
        if isClone then
            inst.Massless = true
        end
    elseif not isClone and (inst:IsA("HingeConstraint") or inst:IsA("BallSocketConstraint")) then
        -- Keep Enabled = true so RequiresNeck / joint connectivity stays valid,
        -- but disable angular limits so PGS solver doesn't fight BulkMoveTo.
        inst.LimitsEnabled = false
    end
end

local function optimizeRig(model, isClone)
    if not model or not model:IsA("Model") then return end
    local stripWrapTarget = (model:FindFirstChildWhichIsA("WrapLayer", true) == nil)
    for _, d in ipairs(model:GetDescendants()) do
        stripPartLag(d, isClone, stripWrapTarget)
    end
    trackConn(model.DescendantAdded:Connect(function(d)
        stripPartLag(d, isClone, stripWrapTarget)
    end))
end

local function optimizeActiveRigs()
    if not LocalPlayer then return end
    local realChar = Workspace:FindFirstChild(LocalPlayer.Name)
    local cloneChar = Workspace:FindFirstChild(LocalPlayer.Name .. "Celeste")
    if realChar and cloneChar then
        optimizeRig(realChar, false)
        optimizeRig(cloneChar, true)
    end
end

