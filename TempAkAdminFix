                    authPctLbl.TextTransparency = authStatusLbl.TextTransparency
                    authPctLbl.Text = string.format("%d%%", dispPct)
                end
            end
        end
    end

    local function findTamperSnapshots(ak)
        if type(ak) ~= "table" then return nil, nil end
        local bf = rawget(ak, "builtInFns")
        local akTamper = rawget(ak, "tamper")
        local cached = g._RbxPlusTamperSnaps
        if type(cached) == "table" and cached.ak == ak and (bf == nil or cached.bf == bf) then
            if type(cached.snapFns) == "table"
                and (akTamper == nil or rawget(cached.snapFns, "tamper") == akTamper)
                and (type(bf) ~= "table" or type(cached.snapBuilt) == "table")
            then
                return cached.snapFns, cached.snapBuilt
            end
        end
        local gcFn = (type(getgc) == "function" and getgc) or (type(g.getgc) == "function" and g.getgc)
        if type(gcFn) ~= "function" then return nil, nil end
        local gu = (type(rawDbg) == "table" and type(rawDbg.getupvalues) == "function" and rawDbg.getupvalues)
            or (type(getupvalues) == "function" and getupvalues)
            or (type(g.getupvalues) == "function" and g.getupvalues)
            or (type(debug) == "table" and type(debug.getupvalues) == "function" and debug.getupvalues)
        if type(gu) ~= "function" then
            local gu1 = (type(rawDbg) == "table" and type(rawDbg.getupvalue) == "function" and rawDbg.getupvalue)
                or (type(getupvalue) == "function" and getupvalue)
                or (type(g.getupvalue) == "function" and g.getupvalue)
                or (type(debug) == "table" and type(debug.getupvalue) == "function" and debug.getupvalue)
            if type(gu1) ~= "function" then return nil, nil end
            gu = function(fn)
                local out = {}
                for idx = 1, 24 do
                    local pk = { pcall(gu1, fn, idx) }
                    if not pk[1] or pk[2] == nil then break end
                    out[#out + 1] = (#pk >= 3 or type(pk[2]) == "string") and pk[3] or pk[2]
                end
                return out
            end
        end
        local okGc, gcList = pcall(gcFn, false)
        if not okGc or type(gcList) ~= "table" then return nil, nil end

        local snapFns, snapBuilt, fallbackSnapFns

        local function isAkUiShape(cand)
            return rawget(cand, "prefs") ~= nil
                or rawget(cand, "builtInFns") ~= nil
                or rawget(cand, "initDone") ~= nil
                or rawget(cand, "dead") ~= nil
        end

        local function isSameBuiltFn(cand, k)
            if type(bf) ~= "table" then return false end
            local bfv = rawget(bf, k)
            return type(bfv) == "function" and rawget(cand, k) == bfv
        end

        local function checkCandTbl(cand, boxHasBf)
            if type(cand) ~= "table" then return end
            if cand ~= ak and not isAkUiShape(cand) then
                if not snapFns and akTamper and rawget(cand, "tamper") == akTamper then
                    snapFns = cand
                elseif not fallbackSnapFns and (boxHasBf or not akTamper)
                    and rawget(cand, "trHook") ~= nil
                    and type(rawget(cand, "reanimRun")) == "function"
                    and type(rawget(cand, "vcRun")) == "function"
                then
                    fallbackSnapFns = cand
                end
            end
            if not snapBuilt and type(bf) == "table" and cand ~= bf then
                if type(rawget(cand, "!rj")) == "function"
                    and type(rawget(cand, "!rejoin")) == "function"
                    and (
                        boxHasBf
                        or isSameBuiltFn(cand, "!destroy")
                        or isSameBuiltFn(cand, "!jumppower")
                        or isSameBuiltFn(cand, "!jump")
                        or isSameBuiltFn(cand, "!serverhop")
                    )
                then
                    snapBuilt = cand
                end
            end
        end

        for i = 1, #gcList do
            local fn = gcList[i]
            if type(fn) == "function" then
                local okU, uvs = pcall(gu, fn)
                if okU and type(uvs) == "table" then
                    for j = 1, 32 do
                        local uv = rawget(uvs, j)
                        if type(uv) == "table" then
                            checkCandTbl(uv, false)
                            local nuv = #uv
                            if nuv > 0 and nuv <= 16 then
                                local boxHasBf = false
                                if type(bf) == "table" then
                                    for k = 1, nuv do
                                        if rawget(uv, k) == bf then
                                            boxHasBf = true
                                            break
                                        end
                                    end
                                end
                                for k = 1, nuv do
                                    checkCandTbl(rawget(uv, k), boxHasBf)
                                end
                            end
                        end
                        if snapFns and (type(bf) ~= "table" or snapBuilt) then
                            break
                        end
                    end
                end
                if snapFns and (type(bf) ~= "table" or snapBuilt) then
                    break
                end
            end
        end
        if not snapFns then snapFns = fallbackSnapFns end

        if snapFns or snapBuilt then
            g._RbxPlusTamperSnaps = { ak = ak, bf = bf, snapFns = snapFns, snapBuilt = snapBuilt }
        end
        return snapFns, snapBuilt
    end

    local function safeSetAkField(ak, tbl, key, newVal, isBuiltIn)
        if type(ak) ~= "table" or type(tbl) ~= "table" then return false end
        if rawget(tbl, key) == newVal then return true end
        local snapFns, snapBuilt = nil, nil
        local hasTamperFn = (type(rawget(ak, "tamper")) == "function")
        if hasTamperFn then
            snapFns, snapBuilt = findTamperSnapshots(ak)
        end
        local tamperActive = hasTamperFn
            and (snapFns ~= nil or snapBuilt ~= nil or rawget(ak, "initDone") == true)
        if tamperActive then
            local snapTbl = isBuiltIn and snapBuilt or snapFns
            if type(snapTbl) == "table" then
                if rawget(snapTbl, key) ~= nil then
                    pcall(rawset, snapTbl, key, newVal)
                end
                pcall(rawset, tbl, key, newVal)
                return true
            end
            -- Tamper watchdog is active and cannot be synced (e.g. no getgc on vanilla reload); avoid popup
            return false
        end
        pcall(rawset, tbl, key, newVal)
        return true
    end
    g._RbxPlusSafeSetAkField = safeSetAkField
    g._RbxPlusFindTamperSnaps = findTamperSnapshots

    local akKeyWrappers = g._RbxPlusAkKeyWrappers
