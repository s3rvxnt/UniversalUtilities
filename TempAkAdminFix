    function vmOps.hashDual31(rawSrc, maxExact, sampleBudget)
        local n = type(rawSrc) == "string" and #rawSrc or 0
        if n == 0 then return "0000000000000000_0" end
        local h1, h2 = 5381, 0
        local function feed(i)
            local b = string.byte(rawSrc, i)
            h1 = (h1 * 131 + b + (i % 251)) % 2147483647
            h2 = (h2 * 65599 + b + (i % 241)) % 2147483647
        end
        local ex = maxExact or 4096
        if n <= ex then
            for i = 1, n do feed(i) end
        else
            local edge = math.min(1024, math.floor(ex / 4))
            for i = 1, edge do feed(i) end
            for i = n - edge + 1, n do feed(i) end
            local budget = math.max(256, sampleBudget or 1024)
            local span = n - (edge * 2)
            if span > 0 then
                local step = math.max(1, math.floor(span / budget))
                for i = edge + 1, n - edge, step do feed(i) end
            end
        end
        return string.format("%08x%08x_%d", h1, h2, n)
    end

