    local function updateBudget(sleepGap, totalDt)
        local minB = isXenoExec and 0.010 or 0.022
        local maxB = isFocused and (isXenoExec and 0.024 or 0.045) or (isXenoExec and 0.030 or 0.065)
        if not isFocused then
            dynBudget = maxB
            return
        end
        if sleepGap > 0.0002 and sleepGap < 0.200 then
            smoothedEngine = smoothedEngine * 0.78 + sleepGap * 0.22
        end
        local workDt = (totalDt > sleepGap) and (totalDt - sleepGap) or totalDt
        if sleepGap > 0.140 or workDt > 0.120 then
            dynBudget = math.max(dynBudget * 0.72, minB)
        elseif sleepGap <= 0.045 and workDt <= maxB * 1.15 then
            dynBudget = math.min(dynBudget + 0.004, maxB)
        else
            dynBudget = math.clamp(dynBudget * 0.92, minB, maxB)
        end
    end

