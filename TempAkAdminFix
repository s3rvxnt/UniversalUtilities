local function patchAKReanimSession()
    local cleanupFn = rawget(_G, "_ak_reanim_cleanup") or genv._ak_reanim_cleanup
    if type(cleanupFn) ~= "function" or patchedCleanups[cleanupFn] then
        optimizeActiveRigs()
        return false
    end
    if not debug or not debug.getupvalues then
        optimizeActiveRigs()
        return false
    end

    local setReanimFn, ctx
    for _, rawUv in pairs(debug.getupvalues(cleanupFn)) do
        local uv = unwrapTable(rawUv)
        if isPlainEnvTable(uv) then
            local f2 = rawget(uv, 2)
            local t5 = unwrapTable(rawget(uv, 5))
            if type(f2) == "function" and type(t5) == "table" and rawget(t5, "togglePower") then
                setReanimFn = f2
                ctx = t5
                break
            end
        end
    end
    if not setReanimFn or not ctx then
        optimizeActiveRigs()
        return false
    end

    patchedCleanups[cleanupFn] = true

    -- 1. Patch ctx.tick to native Luau
    local nativeTick = buildNativeTick(ctx)
    if nativeTick then
        ctx.tick = nativeTick
    end

    -- 2. Find setReanim's state table (u16) and patch Heartbeat loop (u16[29])
    for _, rawUv in pairs(debug.getupvalues(setReanimFn)) do
        local uv = unwrapTable(rawUv)
        if isPlainEnvTable(uv) and type(rawget(uv, 29)) == "function" and type(unwrapTable(rawget(uv, 34))) == "table" then
            local u16 = uv
            local nativeHb = buildNativeHeartbeat(rawget(u16, 29))
            if nativeHb then
                rawset(u16, 29, nativeHb)
                local connBox = unwrapTable(rawget(u16, 30))
                if type(connBox) == "table" and typeof(connBox[239]) == "RBXScriptConnection" and connBox[239].Connected then
                    connBox[239]:Disconnect()
                    connBox[239] = RunService.Heartbeat:Connect(nativeHb)
                end
            end

            -- Wrap setReanim so every toggle ON immediately strips TouchTransmitters & constraints
            local origSetReanim = setReanimFn
            local wrappedSetReanim = function(on, ...)
                local res = origSetReanim(on, ...)
                if on then
                    task.defer(optimizeActiveRigs)
                end
                return res
            end
            for _, rawTuv in pairs(debug.getupvalues(ctx.togglePower)) do
                local tuv = unwrapTable(rawTuv)
                if isPlainEnvTable(tuv) and rawget(tuv, 10) == origSetReanim then
                    rawset(tuv, 10, wrappedSetReanim)
                end
            end
            break
        end
    end

    -- 3. Patch playKeyframeAnim's RunService reference to intercept PreSimulation:Connect
    if type(ctx.playName) == "function" then
        for _, rawUv in pairs(debug.getupvalues(ctx.playName)) do
            local uv = unwrapTable(rawUv)
            if isPlainEnvTable(uv) and type(rawget(uv, 9)) == "function" then
                local playKfFn = rawget(uv, 9)
                for _, rawPuv in pairs(debug.getupvalues(playKfFn)) do
                    local puv = unwrapTable(rawPuv)
                    if isPlainEnvTable(puv) and (rawget(puv, 21) == RunService or rawget(puv, 21) == rsPreSimProxy) then
                        rawset(puv, 21, rsPreSimProxy)
                        local animState = unwrapTable(rawget(puv, 7))
                        if type(animState) == "table" and typeof(animState.poseConnection) == "RBXScriptConnection" and animState.poseConnection.Connected then
                            if getconnections then
                                for _, c in ipairs(getconnections(RunService.PreSimulation)) do
                                    if c.Function then
                                        local pt4 = extractLuraphEnvTable(c.Function)
                                        if pt4 and unwrapTable(pt4[0]) == animState then
                                            local nativePre = buildNativePreSim(c.Function)
                                            animState.poseConnection:Disconnect()
                                            animState.poseConnection = RunService.PreSimulation:Connect(nativePre)
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        break
                    end
                end
                break
            end
        end
    end

    optimizeActiveRigs()
    return true
end

