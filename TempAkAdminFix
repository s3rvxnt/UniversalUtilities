    end
    local function ensureUiTracker(ui)
        if not ui then
            disconnectUiTrackers()
            uiTrack.count = 0
            return 0
        end
        if uiTrack.ui ~= ui then
            disconnectUiTrackers()
            uiTrack.ui = ui
            local okD, desc = pcall(ui.GetDescendants, ui)
            uiTrack.count = (okD and type(desc) == "table") and #desc or 0
            uiTrack.leaf = (okD and type(desc) == "table") and desc[#desc] or nil
            local okK, kids = pcall(ui.GetChildren, ui)
            uiTrack.kid = (okK and type(kids) == "table") and kids[#kids] or nil
            uiTrack.syncAt = os.clock()
            lastUiDescChangeAt = uiTrack.syncAt
            pcall(function()
                if ui.DescendantAdded and ui.DescendantAdded.Connect then
                    uiTrack.descConn = ui.DescendantAdded:Connect(function(d)
                        uiTrack.count = uiTrack.count + 1
                        uiTrack.leaf = d
                        lastUiDescChangeAt = os.clock()
                    end)
                end
                if ui.DescendantRemoving and ui.DescendantRemoving.Connect then
                    uiTrack.remConn = ui.DescendantRemoving:Connect(function()
                        if uiTrack.count > 0 then uiTrack.count = uiTrack.count - 1 end
                    end)
                end
                if ui.ChildAdded and ui.ChildAdded.Connect then
                    uiTrack.childConn = ui.ChildAdded:Connect(function(c)
                        uiTrack.kid = c
                    end)
                end
            end)
        elseif os.clock() - uiTrack.syncAt >= 1.25 then
            uiTrack.syncAt = os.clock()
            local okD, desc = pcall(ui.GetDescendants, ui)
            if okD and type(desc) == "table" then
                uiTrack.count = #desc
                uiTrack.leaf = desc[#desc]
            end
            local okK, kids = pcall(ui.GetChildren, ui)
            if okK and type(kids) == "table" then
                uiTrack.kid = kids[#kids]
            end
        end
        return uiTrack.count
    end

