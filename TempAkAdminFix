    local function jsonEncode(val)
        local hs = getHttpSvc()
        if hs and type(hs.JSONEncode) == "function" then
            local okE, out = pcall(hs.JSONEncode, hs, val)
            if okE and type(out) == "string" then return out end
        end
        local function enc(v)
            local tv = type(v)
            if tv == "string" then
                return '"' .. v:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t") .. '"'
            elseif tv == "number" or tv == "boolean" then
                return tostring(v)
            elseif tv == "table" then
                local nKeys = 0
                for _ in pairs(v) do nKeys = nKeys + 1 end
                if nKeys == 0 then return "{}" end
                local parts = {}
                if #v > 0 and #v == nKeys then
                    for i = 1, #v do parts[#parts + 1] = enc(v[i]) end
                    return "[" .. table.concat(parts, ",") .. "]"
                else
                    for k, kv in pairs(v) do
                        parts[#parts + 1] = enc(tostring(k)) .. ":" .. enc(kv)
                    end
                    return "{" .. table.concat(parts, ",") .. "}"
                end
            end
            return "null"
        end
        local okF, fb = pcall(enc, val)
        return okF and fb or nil
    end

