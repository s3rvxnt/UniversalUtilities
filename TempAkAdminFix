local function patchRejoinCommandHooks()
    local ak = genv.AKUI
    if type(ak) ~= "table" then return false end

    local safeSet = genv._RbxPlusSafeSetAkField
    local kw = genv._RbxPlusAkKeyWrappers
    local rjWrapper = type(kw) == "table" and kw["!rj"] or nil

    local function wrapRejoinEntries(cmds, isBuiltIn)
        if type(cmds) ~= "table" or type(rjWrapper) ~= "function" then return end
        for _, rjKey in ipairs({ "!rj", "!rejoin", "!serverhop" }) do
            local curFn = rawget(cmds, rjKey)
            if type(curFn) == "function" and curFn ~= genv["_RbxPlusWrapped_" .. rjKey] then
                local wrappedRj = rjWrapper(ak, curFn, rjKey)
                if type(wrappedRj) == "function" then
                    if isBuiltIn and type(safeSet) == "function" then
                        safeSet(ak, cmds, rjKey, wrappedRj, true)
                    else
                        cmds[rjKey] = wrappedRj
                    end
                end
            end
        end
    end

    if type(ak.builtInFns) == "table" then
        wrapRejoinEntries(ak.builtInFns, true)
    end

    if type(ak.macRunOne0) == "function" and debug and debug.getupvalues then
        for _, rawUv in pairs(debug.getupvalues(ak.macRunOne0)) do
            local u16 = unwrapTable(rawUv)
            if isPlainEnvTable(u16) then
                local b1 = unwrapTable(rawget(u16, 1))
                if type(b1) == "table" then
                    local cmds = unwrapTable(rawget(b1, 248)) or unwrapTable(rawget(b1, 239))
                    if type(cmds) ~= "table" then
                        for idx = 220, 270 do
                            local cand = unwrapTable(rawget(b1, idx))
                            if type(cand) == "table" and (cand == ak.builtInFns or type(rawget(cand, "!rj")) == "function") then
                                cmds = cand
                                break
                            end
                        end
                    end
                    if type(cmds) == "table" then
                        wrapRejoinEntries(cmds, cmds == ak.builtInFns)
                        break
                    end
                end
            end
        end
    end

    return true
end

