                    local ig = genv._OmniIgnoredThreads
                    if type(ig) ~= "table" then
                        ig = setmetatable({}, { __mode = "k" })
                        genv._OmniIgnoredThreads = ig
                    end
                    ig[th] = true
                end
            end
            local rawW = genv._KernelOrigTaskWait or task.wait
            local deadline = os.clock() + 60
            while os.clock() < deadline do
                local g2 = findGui("AKAdmin2")
                if type(genv.AKUI) == "table" and g2 then
                    if rawget(genv.AKUI, "initDone") ~= true and type(genv._RbxPlusAttachAkHooks) == "function" then
                        pcall(genv._RbxPlusAttachAkHooks, genv.AKUI)
                    end
                    if genv.AKUI.initDone or (g2:FindFirstChild("!jump", true) and not findGui("AKAuthGui")) then
                        break
                    end
                end
                rawW(0.05)
            end
            hookAndApplyAll()
            rawW(0.6)
            hookAndApplyAll()
            rawW(1.4)
            enforceFpsSettings()
        end)
    end
end

genv._RbxPlusReanimBoosterUnload = function(isReload)
    pcall(function()
        local g2 = findGui("AKAdmin2")
        if g2 then
            g2:SetAttribute("_RbxPlusRejoinBtnsHooked", nil)
        end
    end)
    for i = 1, #activeConns do
        pcall(function() activeConns[i]:Disconnect() end)
    end
    table.clear(activeConns)
    local ak = genv.AKUI
    if type(ak) == "table" and not isReload and not rawget(ak, "dead") then
        if type(genv._RbxPlusStripInitMt) == "function" then
            pcall(genv._RbxPlusStripInitMt, ak)
        end
        local safeSet = genv._RbxPlusSafeSetAkField
        local restorePairs = {
            { "reanimRun", genv._RbxPlusOrigReanimRun },
            { "cref", genv._RbxPlusOrig_cref },
            { "vcScan", genv._RbxPlusOrig_vcScan },
            { "vcLevel", genv._RbxPlusOrig_vcLevel },
            { "vcApply", genv._RbxPlusOrig_vcApply },
            { "vcMuted", genv._RbxPlusOrig_vcMuted },
            { "vcDump", genv._RbxPlusOrig_vcDump },
            { "vcRun", genv._RbxPlusOrig_vcRun },
            { "vcBuild", genv._RbxPlusOrig_vcBuild },
            { "reexecGo", genv._RbxPlusOrigReexecGo },
        }
        for _, item in ipairs(restorePairs) do
            if type(item[2]) == "function" then
                if type(safeSet) == "function" then
                    safeSet(ak, ak, item[1], item[2], false)
                elseif rawget(ak, "tamper") == nil then
                    ak[item[1]] = item[2]
                end
            end
        end
        if type(ak.builtInFns) == "table" then
            for _, rjKey in ipairs({ "!rj", "!rejoin", "!serverhop" }) do
                local origCmd = genv["_RbxPlusOrigCmd_" .. rjKey]
                if type(origCmd) == "function" then
                    if type(safeSet) == "function" then
                        safeSet(ak, ak.builtInFns, rjKey, origCmd, true)
                    elseif rawget(ak, "tamper") == nil then
                        ak.builtInFns[rjKey] = origCmd
                    end
                end
            end
        end
    end
end

