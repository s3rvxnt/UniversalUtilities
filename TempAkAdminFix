    g._AKOrigIsc = origIsc
    g._AKOrigDbg = rawDbg

    local execName = "Unknown"
    pcall(function()
        if identifyexecutor then
            execName = tostring((identifyexecutor()))
        elseif getexecutorname then
            execName = tostring((getexecutorname()))
        end
    end)

    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local TweenService = game:GetService("TweenService")

    local function findGui(name)
        local found = CoreGui:FindFirstChild(name)
        if found then return found end
        if gethui then
            local ok, hui = pcall(gethui)
            if ok and hui and hui ~= CoreGui then
                found = hui:FindFirstChild(name)
                if found then return found end
            end
        end
        return nil
    end

    -- Built-in live diagnostic pill + AKAuthGui live progress hijacker
    local statusGui, pillStroke, statusLbl, subLbl, hbConn
    local t0 = os.clock()
    local lastY = t0
    local maxDt = 0
    local curFps = 60
    local spikeCount = 0
    local yieldTotal = 0
    local uiCount = 0
    local uiPhase = ""
    local lastUiCheck = 0
    local curStage = "[1/6] Init"
    local hasError = false

    -- AKAuthGui hijack state
    local authGui, authCard, authStatusLbl, authPctLbl, authFill
    local authLatched = false
    local authBaseText = "Loading AK ADMIN"
    local latchYield = 0
    local maxRawPct = 0
    local visPct = 0
    local lastFillScale = nil

    local function computeRawPct()
        if g.AKUI and g.AKUI.initDone then
            maxRawPct = 100
            return 100
        end
        local raw = 0
        if uiCount > 0 then
            local expected = 4430 + (#Players:GetPlayers() * 15)
            if uiCount >= expected then
                expected = uiCount + 80
            end
            raw = 14 + math.clamp(uiCount / expected, 0, 0.99) * 85
        elseif authLatched then
            raw = math.clamp(4 + (yieldTotal - latchYield) * 0.6, 4, 14)
        end
        if raw > maxRawPct then
            maxRawPct = raw
        end
        return maxRawPct
    end

    local function stepAuthHijack(dt)
        if not authLatched then
            local ag = findGui("AKAuthGui")
            if not ag then return end
            local card
            for _, ch in ipairs(ag:GetChildren()) do
                if ch:IsA("Frame") and ch.Size.X.Offset >= 300 then
                    card = ch
                    break
                end
            end
            if not card then return end

            local track, lbl
            for _, ch in ipairs(card:GetChildren()) do
                if ch:IsA("Frame") and ch.Size.Y.Offset >= 2 and ch.Size.Y.Offset <= 6
                    and ch.Position.Y.Offset >= 95 and ch.Position.Y.Offset <= 120 then
                    track = ch
                elseif ch:IsA("TextLabel") and ch.Name ~= "_AKPct"
                    and ch.Position.Y.Offset >= 70 and ch.Position.Y.Offset <= 106 then
                    lbl = ch
                end
            end
            local fill = track and track:FindFirstChildWhichIsA("Frame")
            if not lbl or not fill then return end

            local txt = lbl.Text or ""
            local hasBrand = txt:upper():find("AK ADMIN", 1, true) ~= nil
            if hasBrand or (uiCount > 0 and card.Size.Y.Offset < 220) then
                authGui = ag
                authCard = card
                authStatusLbl = lbl
                authFill = fill
                authLatched = true
                latchYield = yieldTotal

                if hasBrand then
                    local base = txt:gsub("%s*·.*$", ""):gsub("%.%.%.%s*$", "")
                    if base ~= "" then authBaseText = base end
                end

                maxRawPct = 4
                visPct = 4
                lastFillScale = 0.04

                -- Cancel AK Admin's static 0->100% fake tween on the fill bar
                pcall(function()
                    TweenService:Create(
                        authFill,
                        TweenInfo.new(0.01, Enum.EasingStyle.Linear),
                        { Size = UDim2.new(0.04, 0, 1, 0) }
                    ):Play()
                end)
                authFill.Size = UDim2.new(0.04, 0, 1, 0)

                authStatusLbl.TextXAlignment = Enum.TextXAlignment.Left
                authStatusLbl.TextTruncate = Enum.TextTruncate.AtEnd
                authStatusLbl.Size = UDim2.new(
                    1,
                    -(authStatusLbl.Position.X.Offset + 68),
                    authStatusLbl.Size.Y.Scale,
                    authStatusLbl.Size.Y.Offset
                )

                authPctLbl = card:FindFirstChild("_AKPct")
                if not authPctLbl then
                    authPctLbl = Instance.new("TextLabel")
                    authPctLbl.Name = "_AKPct"
                    authPctLbl.BackgroundTransparency = 1
                    authPctLbl.Font = authStatusLbl.Font
                    authPctLbl.TextSize = authStatusLbl.TextSize
                    authPctLbl.TextColor3 = authStatusLbl.TextColor3
                    authPctLbl.TextXAlignment = Enum.TextXAlignment.Right
                    authPctLbl.TextYAlignment = authStatusLbl.TextYAlignment
                    authPctLbl.AnchorPoint = Vector2.new(1, authStatusLbl.AnchorPoint.Y)
                    authPctLbl.Position = UDim2.new(
                        1, -22,
                        authStatusLbl.Position.Y.Scale,
                        authStatusLbl.Position.Y.Offset
                    )
                    authPctLbl.Size = UDim2.new(
                        0, 48,
                        authStatusLbl.Size.Y.Scale,
                        authStatusLbl.Size.Y.Offset
                    )
                    authPctLbl.Parent = card
                end
                authPctLbl.TextTransparency = authStatusLbl.TextTransparency
                authPctLbl.Text = "4%"
            end
        end

        if authLatched then
            if not authGui or not authGui.Parent or not authFill or not authFill.Parent then
                return
            end
            local targetPct = computeRawPct()
            if targetPct >= 100 then
                visPct = 100
            else
                visPct = visPct + (targetPct - visPct) * math.clamp((dt or 0.016) * 10, 0.05, 1)
                if visPct > targetPct then visPct = targetPct end
            end

            local scale = math.clamp(visPct / 100, 0.04, 1)
            -- Re-cancel if AK Admin chains a follow-up tween on authFill.Size
            if lastFillScale and scale < 0.96 and math.abs(authFill.Size.X.Scale - lastFillScale) > 0.025 then
                pcall(function()
                    TweenService:Create(
                        authFill,
                        TweenInfo.new(0.01, Enum.EasingStyle.Linear),
                        { Size = UDim2.new(scale, 0, 1, 0) }
                    ):Play()
                end)
            end
            authFill.Size = UDim2.new(scale, 0, 1, 0)
            lastFillScale = scale

            local dispPct = math.clamp(math.floor(visPct + 0.5), 1, 100)
            if authStatusLbl and authStatusLbl.Parent then
                local suffix = (dispPct >= 100 and "Ready!")
                    or (uiPhase ~= "" and (uiPhase .. "..."))
                    or "Initializing..."
                authStatusLbl.Text = authBaseText .. " · " .. suffix
                if authPctLbl and authPctLbl.Parent then
                    authPctLbl.TextTransparency = authStatusLbl.TextTransparency
                    authPctLbl.Text = string.format("%d%%", dispPct)
                end
            end
        end
    end

    local function updatePill(dt)
        local now = os.clock()
        if not hasError and (now - lastUiCheck > 0.12) then
            lastUiCheck = now
            pcall(function()
                local ui = findGui("AKAdmin2")
                if ui then
                    uiCount = #ui:GetDescendants()
                    local kids = ui:GetChildren()
                    local lastKid = kids[#kids]
                    if lastKid then
                        local kn = lastKid.Name
                        if kn:find("^Rail") or kn == "InfoHolder" then
                            uiPhase = "Navigation"
                        elseif kn == "DynamicIsland" or kn == "IslandStats" then
                            uiPhase = "Dynamic Island"
                        elseif kn == "CmdBarHolder" or kn == "CmdListHolder" then
                            uiPhase = "Command Bar"
                        elseif kn == "PanelHolder" then
                            local tl = lastKid:FindFirstChildWhichIsA("TextLabel", true)
                            local raw = tl and tl.Text or ""
                            if raw ~= "" and #raw <= 28 then
                                if raw:match("^[%u%s]+$") then
                                    raw = raw:lower()
                                        :gsub("(%a)([%w']*)", function(a, b) return a:upper() .. b end)
                                        :gsub("%f[%a]Ak%f[%A]", "AK")
                                end
                                uiPhase = raw
                            end
                        end
                    end
                end
            end)
        end
        if not hasError then
            pcall(stepAuthHijack, dt)
        end
        if not statusLbl or not subLbl then return end
        local pctStr = (not hasError and (uiCount > 0 or authLatched))
            and string.format(" (%d%% | UI: %d)", math.floor(math.max(visPct, computeRawPct()) + 0.5), uiCount)
            or ""
        statusLbl.Text = string.format("AK Fix v6 [%s] | %s%s", execName, curStage, pctStr)
        subLbl.Text = string.format(
            "%.1fs | FPS: %d | MaxLag: %.0fms | Spikes: %d | Yields: %d",
            now - t0, curFps, maxDt * 1000, spikeCount, yieldTotal
        )
        if not hasError then
            subLbl.TextColor3 = (maxDt < 0.250) and Color3.fromRGB(130, 235, 170)
                or ((maxDt < 1.0) and Color3.fromRGB(255, 205, 90) or Color3.fromRGB(255, 105, 105))
        end
    end

    local function setStatus(txt)
        if hasError then return end
        curStage = tostring(txt)
        pcall(function()
            if not statusGui then
                local parent = (gethui and gethui())
                    or CoreGui
                    or Players.LocalPlayer:FindFirstChild("PlayerGui")
                local old = parent and parent:FindFirstChild("_AKFixStatus")
                if old then old:Destroy() end

                statusGui = Instance.new("ScreenGui")
                statusGui.Name = "_AKFixStatus"
                statusGui.DisplayOrder = 2147483647
                statusGui.IgnoreGuiInset = true
                statusGui.ResetOnSpawn = false

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(0, 460, 0, 44)
                frame.Position = UDim2.new(0.5, -230, 0, 10)
                frame.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
                frame.BackgroundTransparency = 0.12
                frame.BorderSizePixel = 0
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 7)
                corner.Parent = frame
                pillStroke = Instance.new("UIStroke")
                pillStroke.Color = Color3.fromRGB(255, 210, 80)
                pillStroke.Thickness = 1
                pillStroke.Transparency = 0.45
                pillStroke.Parent = frame

                statusLbl = Instance.new("TextLabel")
                statusLbl.Size = UDim2.new(1, -12, 0, 20)
                statusLbl.Position = UDim2.new(0, 6, 0, 3)
                statusLbl.BackgroundTransparency = 1
                statusLbl.TextColor3 = Color3.fromRGB(255, 215, 90)
                statusLbl.TextTruncate = Enum.TextTruncate.AtEnd
                statusLbl.Font = Enum.Font.Code
                statusLbl.TextSize = 13
                statusLbl.Text = ""
                statusLbl.Parent = frame

                subLbl = Instance.new("TextLabel")
                subLbl.Size = UDim2.new(1, -12, 0, 18)
                subLbl.Position = UDim2.new(0, 6, 0, 22)
                subLbl.BackgroundTransparency = 1
                subLbl.TextColor3 = Color3.fromRGB(130, 235, 170)
                subLbl.TextTruncate = Enum.TextTruncate.AtEnd
                subLbl.Font = Enum.Font.Code
                subLbl.TextSize = 12
                subLbl.Text = ""
                subLbl.Parent = frame

                frame.Parent = statusGui
                statusGui.Parent = parent

                hbConn = RunService.Heartbeat:Connect(function(dt)
                    lastY = os.clock()
                    if dt > maxDt then maxDt = dt end
                    if dt > 0.100 then spikeCount = spikeCount + 1 end
                    curFps = math.clamp(math.floor(1 / math.max(dt, 0.001) + 0.5), 1, 240)
                    updatePill(dt)
                    if not hasError and g.AKUI and g.AKUI.initDone and g._AKD then
                        g._AKD()
                    end
                end)
            end
            updatePill(0.016)
        end)
    end

    local s3Thread = nil
    local s3Done = false
    local s3Start = os.clock()
    local yCount = 0

    local function setError(err)
        local clean = tostring(err or "Unknown error")
            :gsub('^%[string ".-"%]:%d+:%s*', "")
            :gsub("^.-:%d+:%s*", "")
            :gsub("%s+", " ")
        setStatus("ERR")
        hasError = true
        s3Done = true
        curStage = "ERR: " .. clean
        pcall(warn, "[AK Fix v6 Error]", err)
        pcall(function()
            if hbConn then hbConn:Disconnect(); hbConn = nil end
            if pillStroke then
                pillStroke.Color = Color3.fromRGB(255, 90, 90)
                pillStroke.Transparency = 0.15
            end
            if statusLbl then
                statusLbl.TextColor3 = Color3.fromRGB(255, 110, 110)
            end
            updatePill(0.016)
            if statusGui and task and task.delay then
                task.delay(15, function()
                    if statusGui then statusGui:Destroy(); statusGui = nil end
                end)
            end
        end)
    end

    setStatus("[1/6] Cleaning cache...")
    if task and task.wait then pcall(task.wait) end

    pcall(function()
        local existing = findGui("AKAdmin2")
        if not existing or #existing:GetDescendants() < 500 then
            if existing then existing:Destroy() end
            g.AK_ADMIN_EXECUTED = nil
            g.AKUI = nil
            if _G then
                _G.AK_ADMIN_EXECUTED = nil
                _G.AKUI = nil
            end
        end
    end)

    pcall(function()
        local isf = isfile or g.isfile
        local rdf = readfile or g.readfile
        local dlf = delfile or g.delfile
        local isd = isfolder or g.isfolder
        local lsf = listfiles or g.listfiles
        if isf and rdf and dlf then
            local function checkJson(f)
                if type(f) == "string" and f:find("%.json$") and isf(f) then
                    local ok, data = pcall(rdf, f)
                    if ok and type(data) == "string" then
                        if #data == 0 or not (data:find("^%s*[{%[]") and data:find("[}%]]%s*$")) then
                            pcall(dlf, f)
                        end
                    end
                end
            end
            for _, f in ipairs({
                "akconfigs.json",
                "ak_cmd_history.json",
                "ak_ui_prefs.json",
                "animation_list_cache.json",
                "ak_waypoints.json",
                "ak_autoexec_games.json",
                "ak_presets.json"
            }) do
                checkJson(f)
            end
            if isd and lsf and isd("AK_ADMIN/lang") then
                for _, f in ipairs(lsf("AK_ADMIN/lang")) do
                    checkJson(f)
                end
            end
        end
    end)

    local _AKP = {
        [785102147]=8828, [2007004171]=92280, [661488376]=64157, [601199165]=22828,
        [1682564619]=5239, [885237975]=46847, [1571799572]=90431, [1680692403]=33157,
        [1546116900]=9405, [141182753]=80298, [1275509515]=62152, [1637968901]=71939,
        [1236683115]=79288, [1303655158]=71422, [1656451781]=52126, [1515524351]=54418,
        [363954932]=61509, [1347070597]=30345, [756760012]=26911, [1437219674]=84703,
        [122879770]=72501, [878366319]=88417, [912756091]=67570, [449818189]=75664,
        [1318464810]=76481, [37680239]=64140, [667001448]=9678, [602732110]=69973,
        [594746435]=80841, [235663668]=93486, [1656500033]=40759, [92591987]=7745,
        [1547542338]=90886, [7451]=7417
    }
    g._AKP = _AKP

    local function _AKS()
        s3Done = false
        s3Start = os.clock()
        s3Thread = (coroutine and coroutine.running and coroutine.running()) or nil
        yCount = 63
        lastY = 0
    end

    local function _AKD()
        if s3Done then return end
        s3Done = true
        pcall(function()
            maxRawPct = 100
            visPct = 100
            pcall(stepAuthHijack, 1)
            if hbConn then hbConn:Disconnect(); hbConn = nil end
            setStatus("[6/6] Loaded!")
            if statusGui and task and task.delay then
                task.delay(2.5, function()
                    if statusGui then statusGui:Destroy(); statusGui = nil end
                end)
            end
        end)
    end

    local function _AKY()
        if s3Done then return end
        yCount = yCount + 1
        if yCount % 64 ~= 0 then return end
        if not s3Thread and coroutine and coroutine.running then
            s3Thread = coroutine.running()
        end
        if s3Thread and coroutine and coroutine.running and coroutine.running() ~= s3Thread then
            return
        end
        local now = os.clock()
        if now - lastY > 0.012 then
            if coroutine and coroutine.isyieldable and not coroutine.isyieldable() then
                yCount = 48
                return
            end
            if task and task.wait then
                yieldTotal = yieldTotal + 1
                if yieldTotal % 8 == 0 then
                    local hasUi = findGui("AKAdmin2") ~= nil
                    setStatus(hasUi and "[6/6] Building UI..." or "[5/6] Running VM...")
                end
                local ok = pcall(task.wait)
                if ok then
                    lastY = os.clock()
                    if g.AKUI and g.AKUI.initDone then
                        _AKD()
                    elseif (lastY - s3Start > 60) and not findGui("AKAuthGui") then
                        _AKD()
                    end
                end
            end
        end
    end
    g._AKS = _AKS
    g._AKY = _AKY
    g._AKD = _AKD

    g.checkcaller = g.checkcaller or c(function(...) return true end)
    local getgenvFn = g.getgenv or getgenv or c(function() return g end)

    local targetDbg = rawDbg
    if type(rawDbg) == "table" then
        local gi, inf, tb = rawDbg.getinfo, rawDbg.info, rawDbg.traceback
        local dFn1, dFn2 = function() end, function() end
        local isC = {
            [pcall]=true, [xpcall]=true, [string.byte]=true, [table.concat]=true,
            [table.pack or 0]=true, [math.floor]=true, [rawget]=true, [rawset]=true,
            [oldLs or 0]=true, [origIsc or 0]=true, [buffer and buffer.readu8 or 0]=true,
            [g.checkcaller]=true, [getgenvFn]=true,
            [_AKS]=true, [_AKY]=true, [_AKD]=true
        }
        isC[0] = nil

        local off = 1
        if inf then
            local probe, testCaller
            probe = c(function(...)
                for k = 1, 4 do
                    if inf(k, "f") == testCaller then return k - 1 end
                end
                return 1
            end)
            testCaller = function() return probe() end
            local ok, v = pcall(testCaller)
            if ok and type(v) == "number" then off = v end
        end

        local dbg = {}
        for k, v in pairs(rawDbg) do dbg[k] = v end

        dbg.getinfo = c(function(...)
            local f, w = ...
            if type(f) == "function" and (isC[f] or (origIsc and origIsc(f))) then
                return {what="C", source="=[C]", short_src="[C]", linedefined=-1, currentline=-1, name="", nups=0, numparams=0, is_vararg=1, func=f}
            end
            local target = type(f) == "number" and (f == 0 and 0 or f + off) or f
            local ok, r = pcall(gi or function() end, target, w)
            r = (ok and type(r) == "table") and r or {}
            if type(f) == "number" or (type(f) == "function" and not isC[f]) then
                if r.what ~= "Lua" and r.what ~= "main" then r.what = "Lua" end
                r.currentline = 1
                r.linedefined = 1
                if type(r.func) ~= "function" then
                    r.func = (type(f) == "function" and f) or (f == 1 and dFn1 or dFn2)
                end
            end
            return r
        end)
        isC[dbg.getinfo] = true

        dbg.info = c(function(...)
            local a, b = ...
            if type(a) == "function" and (isC[a] or (origIsc and origIsc(a))) then
                local w = type(b) == "string" and b or "slfa"
                if w == "slfa" then return "[C]", -1, a, 0, true end
                local out, n = {}, 0
                for i = 1, #w do
                    local ch = w:sub(i, i)
                    if ch == "s" then n = n + 1; out[n] = "[C]"
                    elseif ch == "l" then n = n + 1; out[n] = -1
                    elseif ch == "n" then n = n + 1; out[n] = ""
                    elseif ch == "f" then n = n + 1; out[n] = a
                    elseif ch == "a" then n = n + 1; out[n] = 0; n = n + 1; out[n] = true end
                end
                return (unpack or table.unpack)(out, 1, n)
            end
            if not inf then return '[string "chunk"]', 1, (a == 1 and dFn1 or dFn2), 0, false end
            if type(a) == "number" and type(b) == "string" then
                local lvl = a == 0 and 0 or (a + off)
                local r1, r2, r3, r4, r5, r6 = inf(lvl, b)
                if b == "l" then
                    return 1
                elseif b == "f" then
                    return (type(r1) == "function" and not isC[r1]) and r1 or (a == 1 and dFn1 or dFn2)
                elseif b == "slf" then
                    local s = (type(r1) == "string" and r1 ~= "" and r1 ~= "[C]") and r1 or '[string "chunk"]'
                    local fn = (type(r3) == "function" and not isC[r3]) and r3 or (a == 1 and dFn1 or dFn2)
                    return s, 1, fn
                elseif b:find("l", 1, true) then
                    local s = (type(r1) == "string" and r1 ~= "" and r1 ~= "[C]") and r1 or '[string "chunk"]'
                    return s, 1, r3, r4, r5, r6
                end
                return r1, r2, r3, r4, r5, r6
            end
            return inf(...)
        end)
        isC[dbg.info] = true

        dbg.traceback = c(function(...)
            local m, l = ...
            local lvl = (type(l) == "number" and l >= 0) and (l + off) or (1 + off)
            local ok, s = pcall(tb or function() return "" end, nil, lvl)
            s = (ok and type(s) == "string") and s or ""
            s = s:gsub("^%s*stack traceback:%s*\n?", "")
            if s:sub(1, 5) == "stack" then s = s:sub(6) end
            s = s:gsub(":%d+:", ":1:")
            if not s:find(":1:", 1, true) then
                s = s .. (s ~= "" and not s:find("\n$") and "\n" or "") .. '[string "chunk"]:1: in function\n'
            end
            local _, nl = s:gsub("\n", "\n")
            if nl < 2 then
                s = s .. '[string "chunk"]:1: in main chunk\n'
            end
            if m ~= nil then
                return tostring(m) .. "\n" .. s
            end
            return s
        end)
        isC[dbg.traceback] = true

        if origIsc then
            g.iscclosure = c(function(...)
                local f = ...
                if isC[f] then return true end
                return origIsc(...)
            end)
            isC[g.iscclosure] = true
        end

        pcall(function()
            if setreadonly then setreadonly(rawDbg, false) end
            rawDbg.getinfo, rawDbg.info, rawDbg.traceback = dbg.getinfo, dbg.info, dbg.traceback
        end)
        targetDbg = (rawDbg.info == dbg.info and rawDbg.traceback == dbg.traceback) and rawDbg or dbg
        g.debug = targetDbg
    end

    local env = {
        debug = targetDbg,
        iscclosure = g.iscclosure,
        checkcaller = g.checkcaller,
        getgenv = getgenvFn,
        _AKP = _AKP,
        _AKS = _AKS,
        _AKY = _AKY,
        _AKD = _AKD,
    }

    local selfBindPrefix = "do local _e=(getgenv and getgenv()._AKEnv)or(_G and _G._AKEnv)or(shared and shared._AKEnv);if _e and setfenv then setfenv(1,_e)end end;"

    g.loadstring = function(...)
        local src, name = ...
        local isStage2 = false
        local isStage3 = false
        if type(src) == "string" then
            if src:find("DecompressBuffer", 1, true) then
                isStage2 = true
                setStatus("[3/6] Decompressing Stage 2...")
                if task and task.wait then pcall(task.wait) end
                s3Thread = nil
                src = src
                    :gsub("=%(1/300%)", "=(1/100)")
                    :gsub("local (%w+)=(%w+)%[(%w+)%];", "local %1=(#%2==8886 and %2[8843])or %2[%3];", 1)
                    :gsub("((%w+)%[%((%w+)%+1%)%])=0%+%(%1%);", "%1=(%1==1e9 and 0)or(0+%1);")
                    :gsub("while%(R%.My%)do ", "while(R.My)do _AKY();", 1)
            elseif src:find("elseif h==58 then K[W[U]]=K[z[U]]+K[o[U]]U+=1;", 1, true) then
                isStage3 = true
                s3Done = false
                s3Start = os.clock()
                s3Thread = nil
                setStatus("[4/6] Compiling Stage 3...")
                if task and task.wait then
                    pcall(task.wait)
                end
                local b1, b2 = src:find(",y=[==[", 1, true)
                local e1, e2 = src:find("]==],", b2 or 1, true)
                if b1 and e1 then
                    local blob = src:sub(b2 + 1, e1 - 1)
                    g._AKB = blob
                    env._AKB = blob
                    pcall(rawset, origEnv, "_AKB", blob)
                    src = src:sub(1, b1 - 1) .. ",y=_AKB," .. src:sub(e2 + 1)
                end
                src = src
                    :gsub("^return setmetatable", "_AKS();local _AKR=setmetatable", 1)
                    :gsub(":Ch%(%)%(%.%.%.%)%s*$", ":Ch()(...);_AKD();return _AKR", 1)
                    :gsub("for o=1,#z,5 do ", "for o=1,#z,5 do if o%%200==1 then _AKY()end;", 1)
                    :gsub("while U do if U<=46", "while U do _AKY();if U<=46")
                    :gsub("else U%[90%]=U%[45%]U%[0%]=14386203;end;", "else _AKY();U[90]=U[45]U[0]=14386203;end;", 1)
                    :gsub(
                        "for (%w+)=1,L do local E=U%[209%]%(m,K%)",
                        "for %1=1,L do _AKY();local E=U[209](m,K)"
                    )
                    :gsub(
                        "if (%w+==%d+) then while true do local ",
                        "if %1 then while true do _AKY();local "
                    )
                    :gsub(
                        "while true do F%[7295896%]=W;",
                        "while true do _AKY();F[7295896]=W;"
                    )
                    :gsub(
                        "elseif h==58 then K%[W%[U%]%]=K%[z%[U%]%]%+K%[o%[U%]%]U%+=1;",
                        "elseif h==58 then K[W[U]]=K[z[U]]+(_AKP[K[o[U]]]or K[o[U]])U+=1;",
                        1
                    )
                if task and task.wait then
                    pcall(task.wait)
                end
            end
        end

        local fn, err
        if type(src) == "string" and (isStage2 or isStage3 or not s3Done) then
            fn, err = oldLs(selfBindPrefix .. src, name)
            if not fn then
                fn, err = oldLs(src, name)
            end
        else
            fn, err = oldLs(src, name)
        end

        if not fn and (isStage2 or isStage3) then
            setError((isStage3 and "S3 Compile: " or "S2 Compile: ") .. tostring(err))
            return nil, err
        end

        if isStage3 then
            setStatus("[5/6] Running VM...")
            if task and task.wait then
                pcall(task.wait)
            end
            if task and task.delay then
                task.delay(60, function()
                    if not findGui("AKAuthGui") then _AKD() end
                end)
            end
            yCount = 63
            lastY = 0
        end

        if fn and (isStage2 or isStage3 or not s3Done) then
            if not pcall(setfenv, fn, env) then
                local rawFn = fn
                fn = function(...) return rawFn(...) end
                pcall(setfenv, fn, env)
            end
            local okF, fenv = pcall(getfenv, fn)
            if okF and type(fenv) == "table" then
                pcall(rawset, fenv, "debug", targetDbg)
                pcall(rawset, fenv, "loadstring", g.loadstring)
                pcall(rawset, fenv, "getgenv", getgenvFn)
                pcall(rawset, fenv, "_AKP", _AKP)
                pcall(rawset, fenv, "_AKS", _AKS)
                pcall(rawset, fenv, "_AKY", _AKY)
                pcall(rawset, fenv, "_AKD", _AKD)
                pcall(rawset, fenv, "_AKB", g._AKB)
            end
        end
        return fn, err
    end

    env.loadstring = g.loadstring
    env.load = g.loadstring
    setmetatable(env, {
        __index = function(_, k)
            local v = g[k]
            if v ~= nil then return v end
            if callerEnv then
                v = callerEnv[k]
                if v ~= nil then return v end
            end
            return origEnv[k]
        end,
        __newindex = function(t, k, v)
            rawset(t, k, v)
            pcall(function() g[k] = v end)
            pcall(function() origEnv[k] = v end)
        end
    })

    g._AKEnv = env
    pcall(function() if _G then _G._AKEnv = env end end)
    pcall(function() if shared then shared._AKEnv = env end end)

    pcall(function()
        if setreadonly then setreadonly(origEnv, false) end
        rawset(origEnv, "debug", targetDbg)
        rawset(origEnv, "iscclosure", g.iscclosure)
        rawset(origEnv, "loadstring", g.loadstring)
        rawset(origEnv, "_AKEnv", env)
        rawset(origEnv, "_AKP", _AKP)
        rawset(origEnv, "_AKS", _AKS)
        rawset(origEnv, "_AKY", _AKY)
        rawset(origEnv, "_AKD", _AKD)
    end)

    setStatus("[2/6] Fetching AKADMIN.lua...")
    if task and task.wait then pcall(task.wait) end
    local okRun, runErr = pcall(function()
        local s1Src = game:HttpGet("https://absent.wtf/AKADMIN.lua")
        local s1Fn, s1Err = g.loadstring(s1Src)
        if not s1Fn then
            error("S1 Compile: " .. tostring(s1Err))
        end
        return s1Fn()
    end)
    if not okRun then
        setError(runErr)
    end
end
