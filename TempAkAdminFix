local function hookAndApplyAll()
    local ak = genv.AKUI
    if type(ak) == "table" then
        if rawget(ak, "initDone") ~= true and type(genv._RbxPlusAttachAkHooks) == "function" then
            pcall(genv._RbxPlusAttachAkHooks, ak)
        else
            if type(genv._RbxPlusStripInitMt) == "function" then
                pcall(genv._RbxPlusStripInitMt, ak)
            end
            if type(genv._RbxPlusPatchTranslator) == "function" then
                pcall(genv._RbxPlusPatchTranslator, ak)
            end
            local safeSet = genv._RbxPlusSafeSetAkField
            local kw = genv._RbxPlusAkKeyWrappers
            if type(kw) == "table" then
                for _, key in ipairs({ "reanimRun", "cref", "vcScan", "vcLevel", "vcApply", "vcMuted", "vcDump", "vcRun", "vcBuild", "reexecGo" }) do
                    local wFn = kw[key]
                    local cur = rawget(ak, key)
                    if type(wFn) == "function" and type(cur) == "function" then
                        local wrapped = wFn(ak, cur, key)
                        if type(wrapped) == "function" and wrapped ~= cur then
                            if type(safeSet) == "function" then
                                safeSet(ak, ak, key, wrapped, false)
                            else
                                ak[key] = wrapped
                            end
                        end
                    end
                end
            end
        end

        if type(genv._RbxPlusEnsureVcBtn) == "function" then
            pcall(genv._RbxPlusEnsureVcBtn, ak)
        end

        -- Hook any UI Rejoin buttons directly as well
        local gui = findGui("AKAdmin2")
        if gui and not gui:GetAttribute("_RbxPlusRejoinBtnsHooked") then
            local hookedAny = false
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextButton") and (d.Text == "Rejoin" or d.Text == "Server Hop") then
                    hookedAny = true
                    trackConn(d.MouseButton1Down:Connect(function()
                        rearmTeleportBeforeHop()
                    end))
                end
            end
            if hookedAny then
                gui:SetAttribute("_RbxPlusRejoinBtnsHooked", true)
            end
        end

        if gui and (ak.initDone or (gui:FindFirstChild("!jump", true) and not findGui("AKAuthGui"))) then
            if type(genv._RbxPlusD) == "function" then
                pcall(genv._RbxPlusD)
            end
        end
    end
    enforceFpsSettings()
    patchAKReanimSession()
    patchRejoinCommandHooks()
end

